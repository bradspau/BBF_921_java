@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix ex:   <http://example.org/> .

# Typed conditions without any function (TR292E §4: false by default).
ex:Intent a icm:Intent ;
    log:allOf ( ex:Expectation ) .

ex:Expectation a icm:PropertyExpectation ;
    icm:target ex:Target ;
    log:allOf ( ex:BareLog ex:BareIcm ex:Svc1Up ) .

ex:BareLog a log:Condition .
ex:BareIcm a icm:Condition .

# Leaf conditions: statements about the services (TR292E §3, log:match against the knowledge base).
ex:Svc1Up a icm:Condition ; log:match ( ex:Svc1 ex:status ex:Up ) .

ex:Svc1 ex:status ex:Up .
ex:Svc2 ex:status ex:Up .
ex:Svc3 ex:status ex:Down .
ex:Svc4 ex:status ex:Down .

ex:Target a icm:Target ; rdfs:member ex:Svc1, ex:Svc2, ex:Svc3, ex:Svc4 .
