@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix ex:   <http://example.org/> .

# One property expectation with two quantity conditions on metrics (TR292D, TR292G).
ex:Intent a icm:Intent ;
    log:allOf ( ex:PerformanceExpectation ) .

ex:PerformanceExpectation a icm:PropertyExpectation ;
    icm:target ex:ServiceTarget ;
    log:allOf ( ex:BandwidthCondition ex:LatencyCondition ) .

ex:ServiceTarget a icm:Target ;
    rdfs:member ex:Service .

# Downstream bandwidth >= 100 Mbps
ex:BandwidthCondition a icm:Condition ;
    quan:atLeast ( ex:BandwidthMetric [ rdf:value "100"^^xsd:decimal ; quan:unit "Mbps" ] ) .

# Latency < 25 ms
ex:LatencyCondition a icm:Condition ;
    quan:smaller ( ex:LatencyMetric [ rdf:value "25"^^xsd:decimal ; quan:unit "ms" ] ) .

ex:BandwidthMetric a met:metric .
ex:LatencyMetric   a met:metric .
