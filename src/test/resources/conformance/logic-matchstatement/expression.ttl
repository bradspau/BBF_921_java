@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix ex:   <http://example.org/> .

# log:matchStatement in the form of TR292E §3 / §6.9: the arguments are rdf:Statement nodes.
ex:Intent a icm:Intent ;
    log:allOf ( ex:Expectation ) .

ex:Expectation a icm:PropertyExpectation ;
    icm:target ex:Target ;
    log:allOf ( ex:GoldUser ) .

ex:GoldUser a log:Condition ;
    log:matchStatement ( [ a rdf:Statement ; rdf:subject ex:User1 ; rdf:predicate ex:userClass ; rdf:object ex:Gold ] ) .

ex:User1 ex:userClass ex:Gold .


ex:Svc1 ex:status ex:Up .
ex:Svc2 ex:status ex:Up .
ex:Svc3 ex:status ex:Down .
ex:Svc4 ex:status ex:Down .

ex:Target a icm:Target ; rdfs:member ex:Svc1, ex:Svc2, ex:Svc3, ex:Svc4 .
