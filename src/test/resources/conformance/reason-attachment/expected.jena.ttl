# Hand-written: the rule engine's (specification) expectation where the Java engine deviates; see DEVIATIONS.md.
@prefix bbf: <http://broadband-forum.org/Intent#> .
@prefix ex: <http://example.org/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix pon: <http://broadband-forum.org/ont/pon-resource#> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Expectation
    rdf:value false .

ex:Intent
    rdf:value false .

ex:Mixed
    icm:reason [ rdf:type icm:Reason ; rdfs:label "80 Mbps >= 100 Mbps is false" ] ;
    met:observed ex:obs-bw ;
    rdf:value false .

ex:Named
    rdf:value true .

ex:TrueWithFailingMember
    rdf:value true .

ex:obs-bw
    met:observedMetric ex:BandwidthMetric ;
    quan:unit "Mbps" ;
    rdf:type met:Observation ;
    rdf:value "80"^^xsd:decimal .
