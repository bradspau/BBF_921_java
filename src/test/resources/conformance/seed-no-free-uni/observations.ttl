@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
<http://example.org/obs/0> a met:Observation ;
  met:observedMetric <http://broadband-forum.org/Intent#DownstreamBandwidthMetric> ;
  rdf:value "150"^^xsd:decimal ;
  quan:unit "Mbps" ;
  met:obtainedAt "2026-06-11T10:00:00Z"^^xsd:dateTime .
<http://example.org/obs/3> a met:Observation ;
  met:observedMetric <http://broadband-forum.org/Intent#UpstreamBandwidthMetric> ;
  rdf:value "30"^^xsd:decimal ;
  quan:unit "Mbps" ;
  met:obtainedAt "2026-06-11T10:00:01Z"^^xsd:dateTime .
<http://example.org/obs/6> a met:Observation ;
  met:observedMetric <http://broadband-forum.org/Intent#LatencyMetric> ;
  rdf:value "8"^^xsd:decimal ;
  quan:unit "ms" ;
  met:obtainedAt "2026-06-11T10:00:02Z"^^xsd:dateTime .
<http://example.org/obs/9> a met:Observation ;
  met:observedMetric <http://broadband-forum.org/Intent#JitterMetric> ;
  rdf:value "1.2"^^xsd:decimal ;
  quan:unit "ms" ;
  met:obtainedAt "2026-06-11T10:00:03Z"^^xsd:dateTime .
<http://example.org/obs/12> a met:Observation ;
  met:observedMetric <http://broadband-forum.org/Intent#PacketLossMetric> ;
  rdf:value "0.02"^^xsd:decimal ;
  quan:unit "percent" ;
  met:obtainedAt "2026-06-11T10:00:04Z"^^xsd:dateTime .
