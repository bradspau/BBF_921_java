@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix ex:   <http://example.org/> .
ex:Intent a icm:Intent ;
    log:allOf ( ex:Expectation ) .

ex:Expectation a icm:PropertyExpectation ;
    icm:target ex:ServiceTarget ;
    log:allOf ( ex:FirstTwoEqual ex:FirstTwoDiffer ) .

ex:ServiceTarget a icm:Target ;
    rdfs:member ex:Service .

# 5, 5, 6: not all the same (Java: true, it compares 5 and 5 only).
ex:FirstTwoEqual a icm:Condition ;
    quan:exactly ( 5 5 6 ) .

# 5, 6, 5: false in both engines, with the same reason (the first unequal pair).
ex:FirstTwoDiffer a icm:Condition ;
    quan:exactly ( 5 6 5 ) .
