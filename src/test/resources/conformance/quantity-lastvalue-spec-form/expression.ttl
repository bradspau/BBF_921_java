@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix ex:   <http://example.org/> .

# TR292G §6.1.2 / §8.1.2 (example: quan:smaller ( [ met:lastValue ( ex:sliceLatency ) ] ... )).
ex:Intent a icm:Intent ;
    log:allOf ( ex:Expectation ) .

ex:Expectation a icm:PropertyExpectation ;
    icm:target ex:ServiceTarget ;
    log:allOf ( ex:BandwidthCondition ex:LatencyCondition ) .

ex:ServiceTarget a icm:Target ;
    rdfs:member ex:Service .

# Observed 150 Mbps: true by the PDF.
ex:BandwidthCondition a icm:Condition ;
    quan:atLeast ( [ met:lastValue ( ex:BandwidthMetric ) ] [ rdf:value "100"^^xsd:decimal ; quan:unit "Mbps" ] ) .

# No observation of the latency metric: false, the reason names the metric.
ex:LatencyCondition a icm:Condition ;
    quan:smaller ( [ met:lastValue ( ex:LatencyMetric ) ] [ rdf:value "25"^^xsd:decimal ; quan:unit "ms" ] ) .
