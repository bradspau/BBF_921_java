@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix set:  <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix ex:   <http://example.org/> .

# One expectation with two targets, one with two delivery types.
ex:Intent a icm:Intent ;
    log:allOf ( ex:E1 ex:E2 ) .

ex:E1 a icm:DeliveryExpectation ; icm:target ex:T1 , ex:T2 ; icm:deliveryType ex:Widget ; icm:chooseFrom ex:P1 .
ex:T1 a icm:Target .
ex:T2 a icm:Target .
ex:P1 a icm:Target ; rdfs:member ex:w1 .

ex:E2 a icm:DeliveryExpectation ; icm:target ex:T3 ; icm:deliveryType ex:Widget , ex:Gadget ; icm:chooseFrom ex:P3 .
ex:T3 a icm:Target .
ex:P3 a icm:Target ; rdfs:member ex:w3 .
