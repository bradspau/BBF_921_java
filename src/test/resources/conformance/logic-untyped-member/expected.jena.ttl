# Hand-derived from the PDF (rule engine expectation); differs from expected.ttl (Java). See DEVIATIONS.md entry 10.
@prefix ex: <http://example.org/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:AnyWithUnknown rdf:value false . # anyOf ( false ): ex:Unknown is not a boolean argument and is removed (Java counts it true)

ex:OneWithUnknown rdf:value true .  # oneOf ( true ) (Java: oneOf ( true true ) = false)

ex:Expectation rdf:value true .

ex:Intent rdf:value true .

ex:Svc1Up rdf:value true .

ex:Svc3Up rdf:value false .
