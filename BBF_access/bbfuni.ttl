@prefix dct:  <http://purl.org/dc/terms/> .

# Class definitions
bbf:UNIInterface a rdfs:Class ;
    rdfs:label "UNI Interface" .

# Resource definitions  
bbf:OperationalUp a rdfs:Resource ;
    rdfs:label "Operational Up State" .

bbf:NorthRegion a rdfs:Resource ;
    rdfs:label "North Region" .
    
bbf:Ready a rdfs:Resource ;
    rdfs:label "Ready Provisioning State" .

# Property definitions
bbf:inUse a rdf:Property ;
    rdfs:range xsd:boolean .
    
bbf:operationalState a rdf:Property .
bbf:region a rdf:Property .

bbf:UNI1 a bbf:UNIInterface ;
         bbf:inUse false ;
         bbf:operationalState bbf:OperationalUp;
         bbf:provisioningState bbf:Ready ;
         bbf:region bbf:NorthRegion .
bbf:UNI2 a bbf:UNIInterface ;
         bbf:inUse false ;
         bbf:operationalState bbf:OperationalUp;
         bbf:provisioningState bbf:Ready ;
         bbf:region bbf:SouthRegion .
bbf:UNI3 a bbf:UNIInterface ;
         bbf:inUse false ;
         bbf:operationalState bbf:OperationalUp;
         bbf:provisioningState bbf:Ready ;
         bbf:region bbf:NorthRegion .         
bbf:UNI4 a bbf:UNIInterface ;
         bbf:inUse false ;
         bbf:operationalState bbf:OperationalUp;
         bbf:provisioningState bbf:Ready ;
         bbf:region bbf:NorthRegion .
bbf:UNI5 a bbf:UNIInterface ;
         bbf:inUse false ;
         bbf:operationalState bbf:OperationalUp;
         bbf:provisioningState bbf:Ready ;
         bbf:region bbf:SouthRegion .


