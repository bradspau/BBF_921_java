# Function Definition Ontology version 3.6.0

@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Function Definition Ontology"@en ;
  rdfs:comment "This is the Function Definition Ontology model within the TM Forum Intent Ontology (TIO). It provides vocabulary for defining properties that can be used as functions. Functions have a list of arguments in their range and provide an result value. Functions defined based on this ontology can be used as elements in intent expression. They improve intuition when working with the intent models."@en ;
  dct:title "Function Definition Ontology"@en ;
  dct:description "This is the Function Definition Ontology model within the TM Forum Intent Ontology (TIO). It provides vocabulary for defining properties that can be used as functions. Functions have a list of arguments in their range and provide an result value. Functions defined based on this ontology can be used as elements in intent expression. They improve intuition when working with the intent models."@en ;
  dct:subject "function defintion"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/FunctionOntology/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292c-function-definition-ontology-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en ;
  skos:changeNote "2024-10-09 - Error correction: removed fum:resultProperty. This is an error not yet fixed in the published vocabulary reference of v3.6.0, but corrected already in this file."@en ;
  skos:changeNote "2024-10-09 - Error correction: add fum:resultIfInvalid. This is an error not yet fixed in the published vocabulary reference of v3.6.0, but corrected already in this file."@en 
.

fun:argumentNames
  rdfs:label "Argument Names Property"@en ;
  rdfs:comment "The property fun:argumentNames is used in function definitions. It allows connecting each argument of the function to a property of the function. The range of fun:argumentNames is a list which contains one entry per function argument in the order of function arguments. Each entry refers to a property and is interpreted as a property of the function. The properties can be provided directly in the function definition and outside the arguments as well. The values provided for a property in the arguments has preference and would override the values assigned directly to the function. This means the equivalent properties used directly in the function definition are defaults."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range rdf:List
.

fun:argumentTypes
  rdfs:label "Argument Types Property"@en ;
  rdfs:comment "The property fun:argumentTypes defines the type of each argument of a function. It uses a collection of types expressing the type of each respective argument of the function. For example, if the 1st member of the collection of fun:argumentTypes is rdf:Container and the second member is quan:Quantity, this means that the first argument of the function needs to be a container and the second argument needs to be a quantity. If the function can have more arguments than matched by elements in fun:argumentTypes, the last defined type determines the type of all additional arguments."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range rdf:List
.

fun:arityMax
  rdfs:label "Max Arity Property"@en ;
  rdfs:comment "Defines the maximum number of arguments the function would consider. If the argument collection of the function contains more entries, only the entries up to the max arity are considered, and further entries are ignored."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range xsd:nonNegativeInteger
.

fun:arityMin
  rdfs:label "Min Arity Property"@en ;
  rdfs:comment "Defines the minimum number of arguments the function requires."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range xsd:nonNegativeInteger
.

fun:Error
  rdfs:label "Function Error Class"@en ;
  rdfs:comment "Instances of class fun:Error are types of errors related to functions and function evaluation. It is a specialization of class imo:Error, which refers to all errors happening in intent handling."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Error
.

fun:Function
  rdf:type rdf:Property ;
  rdfs:label "Function Property"@en ;
  rdfs:comment "An instance of fun:Function represents a function. It is a sub-property of rdf:Property. Therefore, instances of fun:Function can be used as properties in statements. The range of all instances of fun:Function is a list. It represents the list of function arguments."@en ;
  rdf:subPropertyOf rdf:Property ;
  rdfs:range rdf:List
.

fun:resultIfInvalid
  rdfs:label "Result If Invalid Property"@en ;
  rdfs:comment "The property fun:resultIfInvalid allows specifying a result value to be used in case the function is not valid."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function 
.

fun:resultType
  rdfs:label "Result Type Property"@en ;
  rdfs:comment "Defines the type of the function evaluation result. This is synonymous to the type of value associated with the subject from function evaluation."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
.

fun:Vocabulary
  rdfs:label "Function Definition Vocabulary"@en ;
  rdfs:comment "The object fun:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member fun:argumentNames ,
              fun:argumentTypes ,
              fun:arityMax ,
              fun:arityMin ,
              fun:Error ,
              fun:Function ,
              fun:resultIfInvalid ,
              fun:resultType ,
              fun:Warning 
.

fun:Warning
  rdfs:label "Function Warning Class"@en ;
  rdfs:comment "Instances of class fun:Warning are types of warnings related to functions and function evaluation. It is a specialization of class imo:Warning, which refers to all warnings generated in intent handling."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Warning
.

# Intent Common Model v3.6.0

@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/>
  rdf:type imo:IntentCommonModel ;
  rdfs:label "Intent Common Model"@en ;
  rdfs:Comment "This is the Intent Common Model within the TM Forum Intent Ontology (TIO)"@en ;
  dct:title "Intent Common Model"@en ;
  dct:description "This is the Intent Common Model within the TM Forum Intent Ontology (TIO)"@en ;
  dct:subject "intent model specification"@en ,
              "intent expression"@en ,
              "intent report expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentCommonModel/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-07-26"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/intent-common-model-intent-expression-v3-6-0-tr290a/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/intent-common-model-intent-reporting-v3-6-0-tr290b/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-07-26 - initial draft of turtle file"@en ;
  skos:changeNote "2024-10-09 - editorial correction in turtle file"@en 
.

icm:about
  rdfs:label "About Property"@en ;
  rdfs:comment "The property icm:about references the intent element the intent report element is reporting about."@en ;
  rdf:type rdf:Property 
.

icm:chooseFrom
  rdfs:label "Choose From Property"@en ;
  rdfs:comment "The property icm:chooseFrom provides a container of resources in its range. These are the resources, from which a choice can be made. The intent handler can choose a single resource or several depending on the use case specific needs. These resources would then be considered additions to the target assigned to the delivery expectation."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:DeliveryExpectation ;
  rdfs:range rdfs:Container 
.

icm:ConditionReport
  rdfs:label "Condition Report Class"@en ;
  rdfs:comment "The report for a condition object is provided by an instance of class icm:ConditionReport."@en ;
  rdf:type rdfs:Class 
.

icm:Context
  rdfs:label "Context Class"@en ;
  rdfs:comment "The class icm:Context expresses that its instances are providing contextual information to other intent elements. Context objects provide additional information which impacts the interpretation of requirements. The intent common model does not define specific types of context, but intent extension models can define subclasses of icm:Context to do so."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:IntentElement
.

icm:context
  rdfs:label "Context Property"@en ;
  rdfs:comment "The property icm:context allows assigning context objects to resources and in particular to elements of an intent. The intent common model does not specific types of context, but intent extension models can define sub properties of icm:context specific to subclasses of context."@en ;
  rdf:type rdf:Property ;
  rdfs:range icm:Context
.

icm:ContextReport
  rdfs:label "Context Report Class"@en ;
  rdfs:comment "A report about a context is provided by an instance of class icm:ContextReport."@en ;
  rdf:type rdfs:Class
.

icm:contextReport
  rdfs:label "Context Report Property"@en ;
  rdfs:comment "The property icm:contextReport can be used to assign context reports to elements of the intent report that reports about the elements of an intent that had the respective context."@en ;
  rdf:type rdf:Property ;
  rdfs:range icm:ContextReport
.

icm:deliveryDescription
  rdfs:label "Delivery Description Property"@en ;
  rdfs:comment "The property icm:deliveryDescription is a parameter used in delivery expectations. It expresses where a detailed description of the expected delivery can be found and specifies the resource that contains if."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:DeliveryExpectation ;
  rdfs:range rdfs:Resource
.

icm:DeliveryExpectation
  rdfs:label "Delivery Expectation Class"@en ;
  rdfs:comment "The class icm:DeliveryExpectation expresses that its instance is a special type of expectation for specifying the requirement that something needs to be delivered. The details are expressed by its properties."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Expectation
.

icm:DeliveryExpectationReport
  rdfs:label "Delivery Expectation Report Class"@en ;
  rdfs:comment "The report for a delivery expectation is provided by an instance of class icm:DeliveryExpectationReport within an Intent Report."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ExpectationReport
.

icm:deliveryType
  rdfs:label "Delivery Type Property"@en ;
  rdfs:comment "The property icm:deliveryType is a parameter used in delivery expectations. It expresses the requirement that the target resource shall be an instance of the specified class."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:DeliveryExpectation ;
  rdfs:range rdfs:Class
.

icm:Expectation
  rdfs:label "Expectation Class"@en ;
  rdfs:comment "The class icm:Expectation expresses that its intent is an expectation object. It defines a set of requirements within an Intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:IntentElement
.

icm:ExpectationReport
  rdfs:label "Expectation Report Class"@en ;
  rdfs:comment "The class icm:ExpectationReport with its subclasses represent the reports for expectations defined in an intent."@en ;
  rdf:type rdfs:Class 
.

icm:Information
  rdfs:label "Intent Element Class"@en ;
  rdfs:comment "The instances of class icm:Information provide additional information about resources and in particular intent or intent report elements. Information objects provide additional insights and context but without impacting the interpretation of requirements. The intent common model does not define specific types of information, but intent extension models can add subclasses of icm:Information to do so."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:IntentElement
.

icm:information
  rdfs:label "Information Class"@en ;
  rdfs:comment "The property icm:information allows assigning information objects to resources and in particular to elements of an intent or intent report. The intent common model does not define specific types of information, but intent extension models can add subclasses of icm:Information and also define respective sub properties of icm:information with a range specific to subclasses of information."@en ;
  rdf:type rdf:Property ;
  rdfs:range icm:Information
.

icm:Intent
  rdfs:label "Intent Class"@en ;
  rdfs:comment "The class icm:Intent expresses that its instance is an intent object. As such it defines requirements."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:IntentElement 
.

icm:IntentReport
  rdfs:label "Intent Report Class"@en ;
  rdfs:comment "Intent reports are instances of the class icm:IntentReport."@en ;
  rdf:type rdfs:Class
.

icm:IntentElement
  rdfs:label "Intent Element Class"@en ;
  rdfs:comment "Objects of class icm:intentElement are distinct components of the intent expression. Intent elements participate in defining requirements and intent reports can provide details about them."@en ;
  rdfs:type rdfs:Class
.

icm:intentElements
  rdfs:label "Intent Elements Function"@en ;
  rdfs:comment "The function icm:intentElements represents a container of all individual intent element resources used to express requirements for the intent elements given as arguments. This includes the given intent element object itself and its parents. It represents all intent elements in the subtree that contains the function argument."@en ;
  rdf:type fun:Function ;
  fun:resultTtype rdfs:Container ;
  fun:argumentTypes ( icm:IntentElement ) 
.

icm:intentHandlingState
  rdfs:label "Intent Handling State Property"@en ;
  rdfs:comment "The intent handler maintains an intent handling state machine for every intent. An intent report states the intent handling state at the moment of intent report generation using of the property icm:intentHandlingState."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range imo:IntentHandlingState
.

icm:intentUpdateState
  rdfs:label "Intent Update State Property"@en ;
  rdfs:comment "The intent handler maintains an intent update state machine for every intent. An intent report states the intent update state at the moment of intent report generation using of the property icm:intentUpdateState."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range imo:IntentHandlingState
.

icm:ObservationReportingExpectation
  rdfs:label "Observation Reporting Expectation Class"@en ;
  rdfs:comment "Requesting intent reports with reporting expectations of class icm:ObservationReportingExpectaion leads to intent reports containing observations for metrics used in the intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ReportingExpectation
.

icm:PropertyExpectation
  rdfs:label "Property Expectation Class"@en ;
  rdfs:comment "The class icm:PropertyExpectation expresses that its instance is a special type of expectation for specifying requirements based on properties such as, for example, metrics, KPI, states and other observations."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Expectation
.

icm:PropertyExpectationReport
  rdfs:label "Property Expectation Report Class"@en ;
  rdfs:comment "The report for a property expectation is provided by an instance of class icm:PropertyExpectationReport within an intent report."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf  icm:ExpectationReport
.

icm:Reason
  rdfs:label "Reason Class"@en ;
  rdfs:comment "Instances of class icm:Reason specify explanations for intent handling results."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ExpectationReport
.

icm:reason
  rdfs:label "Reason Property"@en ;
  rdfs:comment "The property icm:reason would assign a reason to an intent report element."@en ;
  rdf:type rdf:Property ;
  rdfs:range icm:Reason
.

icm:reportDestination
  rdfs:label "Report Destination Property"@en ;
  rdfs:comment "The property icm:reportDestination is used with a reporting expectation, and it specifies where to send the required report to. The object of the property is a resource that represents a wanted receiver of the intent report. When a report is generated, it would be sent to this receiver."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:ReportingExpectation
.

icm:reportDestinations
  rdfs:label "Report Destinations Property"@en ;
  rdfs:comment "The property icm:reportDestinations is used with a reporting expectation, and it specifies where to send the required report to. The object of the property is a container with member resources that represent the wanted receivers of the intent report. When a report is generated, it would be sent to all receivers specified in the container."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:ReportingExpectation ;
  rdfs:range rdfs:Container
.

icm:reportGenerated
  rdfs:label "Report Generated Property"@en ;
  rdfs:comment "The property icm:reportGenerated assigns the timestamp of report generation to an intent report instance."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range t:Instant
.

icm:ReportingExpectation
  rdfs:label "Reporting Expectation Class"@en ;
  rdfs:comment "The class icm:ReportingExpectation expresses that its instance is a special type of expectation for specifying the conditions and scope of intent reports. It allows subscribing to intent reports and determine its content and condition of generation."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Expectation
.

icm:ReportingExpectationReport
  rdfs:label "Reporting Expectation Report Class"@en ;
  rdfs:comment "The report for a reporting expectation is provided by an instance of class icm:ReportingExpectationReport."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ExpectationReport
.

icm:reportNumber
  rdfs:label "Report Number Property"@en ;
  rdfs:comment "The property icm:reportNumber assigns a sequence number to the intent report instance."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range xsd:positiveInteger
.

icm:reportTriggers
  rdfs:label "Report Triggers Property"@en ;
  rdfs:comment "The property icm:reportTriggers specifies the events that shall initiate the generation and distribution of an intent report. It is a property used in reporting expectations."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:ReportingExpectation ;
  rdfs:range rdfs:Container 
  # container with members of type imo:Event
.

icm:result
  rdfs:label "Result Property"@en ;
  rdfs:comment "The property icm:result states the evaluation result of the intent element at the time of report generation. It is a boolean truth value."@en ;
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean
.

icm:resultFrom
  rdfs:label "Result From Property"@en ;
  rdfs:comment "The property icm:resultFrom associates an element of the intent report with another element of an intent report. Its subject is the report of an intent element that has a boolean truth value resulting from a logical evaluation. The object of icm:resultFrom is the report of an element in the intent that directly contributed to that evaluation."@en ;
  rdf:type rdf:Property
.

icm:Target
  rdfs:label "Target Class"@en ;
  rdfs:comment "The class icm:Target expresses that its instance is a target specification. Targets define a set of resources that are expected to fulfill the requirements they are associated with through an expectation."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf rdfs:Container ;
  rdfs:subClassOf icm:IntentElement
.

icm:target
  rdfs:label "Target Property"@en ;
  rdfs:comment "The property icm:target assigns an object of class icm:Target to an expectation. It therefore specifies the targets for all requirements within this expectation."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:Expectation ;
  rdfs:range icm:Target
.

icm:targetCount
  rdfs:label "Target Count Property"@en ;
  rdfs:comment "The property icm:targetCount specifies the number of member resources of the target report object."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:TargetReport ;
  rdfs:range xsd:nonNegativeInteger 
.

icm:TargetReport
  rdfs:label "Target Report Class"@en ;
  rdfs:comment "The report for a target is provided by an instance of class icm:TargetReport."@en ;
  rdf:type rdfs:Class
.

icm:targetReport
  rdfs:label "Target Report Property"@en ;
  rdfs:comment "The report for a target is assigned to an expectation report with the property icm:targetReport."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:ExpectationReport ;
  rdfs:range icm:TargetReport
.

icm:valuesOfTargetProperty
  rdfs:label "Values of Target Property Function"@en ;
  rdfs:comment "The function icm:valuesOfTargetProperty represents a container of all values that are assigned to members of the target container with the properties specified as function argument. If multiple properties are specified as arguments the result is a superset of all values from all specified properties."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdf:Property ) 
.

icm:Vocabulary
  rdfs:label "Intent Common Model Vocabulary"@en ;
  rdfs:comment "The object icm:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member icm:about , 
              icm:chooseFrom , 
			  icm:ConditionReport ,
			  icm:Context ,
			  icm:context ,
			  icm:ContextReport ,
			  icm:contextReport ,
			  icm:deliveryDescription ,
			  icm:DeliveryExpectation ,
			  icm:DeliveryExpectationReport ,
			  icm:deliveryType ,
			  icm:Expectation ,
			  icm:ExpectationReport ,
			  icm:Information ,
			  icm:information ,
			  icm:Intent ,
			  icm:IntentReport ,
			  icm:IntentElement ,
			  icm:intentElements ,
			  icm:intentHandlingState ,
			  icm:intentUpdateState ,
			  icm:ObservationReportingExpectation ,
			  icm:PropertyExpectation ,
			  icm:PropertyExpectationReport ,
			  icm:Reason ,
			  icm:reason ,
			  icm:reportDestination ,
			  icm:reportDestinations ,
			  icm:reportGenerated ,
			  icm:ReportingExpectation ,
			  icm:ReportingExpectationReport ,
			  icm:reportNumber ,
			  icm:reportTriggers ,
			  icm:result ,
			  icm:resultFrom ,
			  icm:Target ,
			  icm:target ,
			  icm:targetCount ,
			  icm:TargetReport ,
			  icm:targetReport ,
			  icm:valuesOfTargetProperty
.

# Intent Guarantee Ontology v3.6.0

@prefix ig:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Preference Of Intent Handling Outcomes Model"@en ;
  rdfs:Comment "The Intent Guarantee model extends the vocabulary of the TM Forum Intent Ontology (TIO) to support the request for guarantees that are future looking and that are statements of enduring compliance."@en ;
  dct:title "Preference Of Intent Handling Outcomes Model"@en ;
  dct:description "The Intent Guarantee model extends the vocabulary of the TM Forum Intent Ontology (TIO) to support the request for guarantees that are future looking and that are statements of enduring compliance."@en ;
  dct:subject "intent guarantee"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentGuaranteeOntology/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291h-intent-guarantee-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

ig:GuaranteeAccepted
  rdfs:label "Guarantee Accepted Event Class"@en ;
  rdfs:comment "The class ig:GuaranteeAccepted specifies an event. The meaning of the event is that the intent handler has concluded that it is capable of issuing a requested guarantee for the next guarantee period. The guarantee target state is GuaranteeStateCompliant."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Event
.

ig:confidenceLevel
  rdfs:label "Confidence Level Property"@en ;
  rdfs:comment "The property ig:confidenceLevel specifies a required, predicted or real (measured) confidence/probability level, as a value between 0-1 (percentage). If not specified the confidence is assumed to be 1 (100%)."@en ;
  rdf:type rdf:Property ;
  rdfs:range xsd:decimal
.

ig:ConfidenceLevelNotObtainable
  rdfs:label "Confidence Level Not Obtainable Reason Class"@en ;
  rdfs:comment "The class ig:Complies specifies a reason for rejection of a guarantee. The requested confidence level is not possible to reach for during the guarantee period, according to predictions."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Reason
.

ig:ConfidenceLevelNotReached
  rdfs:label "Confidence Level Not Reached Reason Class"@en ;
  rdfs:comment "The class ig:Complies specifies a reason for degradation of a guarantee. The requested confidence level was not reached during the evaluation window."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Reason
.

ig:ConflictingGuarantees
  rdfs:label "Conflicting Guarantees Reason Class"@en ;
  rdfs:comment "The class ig:Complies specifies a reason for rejection of a guarantee. A requirement is associated with more than one guarantee context, of which more than one is valid at some point in time during the upcoming guarantee period."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Reason
.

ig:Guarantee
  rdfs:label "Guarantee Context Class"@en ;
  rdfs:comment "The class Guarantee is a context that, when associated with requirements (objects of type icm:Expectation, icm:Condition and icm:Intent), modifies the status of those requirements to guaranteed."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Context
.

ig:guaranteePeriod
  rdfs:label "Guarantee Period Property"@en ;
  rdfs:comment "The property ig:guaranteePeriod specifies the duration of guarantee periods, in ISO8601 format. If not specified in a guarantee reporting expectation the guarantee period is the entire life-span of the associated intent, which is generally indefinite unless limited by other vocabulary."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ig:GuaranteeReportingExpectation ;
  rdfs:range xsd:duration
.

ig:GuaranteePeriodUpdate
  rdfs:label "Guarantee Period Update Event Class"@en ;
  rdfs:comment "The class ig:GuaranteePeriodUpdate specifies an event. The meaning of the event is that a new evaluation and planning phase has been initiated as a result of periodic updating or the end of the previous guarantee period. The guarantee target state is either GuaranteeStateCompliant or GuaranteeStateDegraded, depending on the outcome."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Event
.

ig:guaranteePeriodUpdateInterval
  rdfs:label "Guarantee Period Update Interval Property"@en ;
  rdfs:comment "The property ig:guaranteePeriodUpdateInterval specifies the interval of re-evaluation and planning of guarantee periods, in ISO8601 format. If not specified in a guarantee reporting expectation the guarantee period update interval is the same as the guarantee period."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ig:GuaranteeReportingExpectation ;
  rdfs:range xsd:duration
.

ig:GuaranteePeriodNotObtainable
  rdfs:label "Guarantee Period Not Obtainable Reason Class"@en ;
  rdfs:comment "The class ig:Complies specifies a reason for rejection of a guarantee. It is not possible to guarantee the requirement during the requested guarantee period."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Reason
.

ig:GuaranteePeriodTooLong
  rdfs:label "Guarantee Period Too Long Reason Class"@en ;
  rdfs:comment "The class ig:Complies specifies an reason for rejection of a guarantee. The requested guarantee period is too long for the intent handler to accurately predict and plan for the guarantee, this is a result of limitations in implementation."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf  icm:Reason
.

ig:GuaranteePeriodUpdateIntervalTooLong
  rdfs:label "Guarantee Period Update Interval Too Long Reason Class"@en ;
  rdfs:comment "The class ig:GuaranteePeriodUpdateIntervalTooLong specifies a warning. The requested guarantee period update interval is longer than the guarantee period. The result is that it is void and the guarantee period and update interval is the same."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Reason
.

ig:GuaranteeRejected
  rdfs:label "Guarantee Rejected Event Class"@en ;
  rdfs:comment "The class ig:GuaranteeRejected specifies an event. The meaning of the event is that the intent handler has concluded that it is not capable of issuing a requested guarantee. The guarantee target state is ig:GuaranteeStateRejected."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Event
.

ig:GuaranteeReportingExpectation
  rdfs:label "Guarantee Reporting Expectation Class"@en ;
  rdfs:comment "The class ig:GuaranteeReportingExpectation specifies a reporting expectation for guarantees and is used to configure a specific guarantee period and conditions for when to issue reports related to guarantees."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf  icm:ReportingExpectation
.

ig:GuaranteeStateCompliant
  rdfs:label "Guarantee State Compliant Class"@en ;
  rdfs:comment "The class ig:GuaratneeStateCompliant specifies a state. The meaning of the state is that the intent handler has concluded that it's capable of delivering the guarantee for the next guarantee period. Possible events transitioning from this state are imo:UpdateReceived and ig:GuaranteePeriodUpdate."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf ig:State
.

ig:GuaranteeStateDegraded
  rdfs:label "Guarantee State Degraded Class"@en ;
  rdfs:comment "The class ig:GuaratneeStateDegraded specifies a state. The meaning of the state is that the intent handler has concluded that it's not capable of delivering the guarantee for the next guarantee period. Possible events transitioning from this state are imo:UpdateReceived and ig:GuaranteePeriodUpdate."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf ig:State
.

ig:hasGuarantee
  rdfs:label "Has Guarantee Property"@en ;
  rdfs:comment "The property ig:hasGuarantee is used to associate a guarantee context with a requirement (objects of type icm:Expectation, icm:Condition and icm:Intent)."@en ;
  rdf:type rdf:Property ;
  rdfs:range ig:Guarantee
.

ig:State
  rdfs:label "State Class"@en ;
  rdfs:comment "The class ig:State is a base-class of Guarantee states."@en ;
  rdf:type rdfs:Class
.

ig:state
  rdfs:label "State Property"@en ;
  rdfs:comment "The property ig:state specifies the state of a guarantee."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ig:GuaranteeReport ;
  rdfs:range ig:State
.

ig:until
  rdfs:label "Until Property"@en ;
  rdfs:comment "The property ig:until specifies the expiry date and time of a guarantee period, in ISO8601 format."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ig:GuaranteeReport ;
  rdfs:range xsd:dateTime
.

ig:Vocabulary
  rdfs:label "Guarantee Vocabulary"@en ;
  rdfs:comment "The object ig:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member ig:GuaranteeAccepted ,
              ig:confidenceLevel ,
              ig:ConfidenceLevelNotObtainable ,
              ig:ConfidenceLevelNotReached ,
              ig:ConflictingGuarantees ,
              ig:Guarantee ,
              ig:guaranteePeriod ,
              ig:GuaranteePeriodUpdate ,
              ig:guaranteePeriodUpdateInterval ,
              ig:GuaranteePeriodNotObtainable ,
              ig:GuaranteePeriodTooLong ,
              ig:GuaranteePeriodUpdateIntervalTooLong ,
              ig:GuaranteeRejected ,
              ig:GuaranteeReportingExpectation ,
              ig:GuaranteeStateCompliant ,
              ig:GuaranteeStateDegraded ,
              ig:hasGuarantee ,
              ig:State ,
              ig:state ,
              ig:until 
.

# Intent Management Ontology version 3.6.0

@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Intent Managment Ontology"@en ;
  rdfs:Comment "This is the Intent Management Ontology model within the TM Forum Intent Ontology (TIO)"@en ;
  dct:title "Intent Managment Ontology"@en ;
  dct:description "This is the Intent Management Ontology model within the TM Forum Intent Ontology (TIO)"@en ;
  dct:subject "intent managment elements"@en,
              "intent managment state machines"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagmentOntology/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentManagmentOntology/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292a-intent-management-elements-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292b-intent-management-state-machines-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en ;
.

imo:associatedValueCombination
  rdfs:label "Associated Value Combination Property"@en ;
  rdfs:comment "The property imo:associatedValueCombination specifies the combination function to be applied if multiple contributors to the associated value of an instance a class are used."@en ;
  rdf:type rdf:Property ;
  rdfs:domain rdfs:Class ;
  rdfs:range fun:Function
.

imo:associatedValueType
  rdfs:label "Associated Value Type Property"@en ;
  rdfs:comment "The property imo:associatedValueType specifies the type of the associated value of instances of a class. If this property is used in the definition of a class, instances of this class have associated values."@en ;
  rdf:type rdf:Property ;
  rdfs:domain rdfs:Class
.

imo:BaseOntologyModel
  rdfs:label "Base Ontology Model Class"@en ;
  rdfs:comment "The class imo:BaseOntologyModel is a subclass of imo:TIOmodel. Its instances are models within the TM Forum Intent Ontology. Intent common models and intent extension models rely on the fundamental vocabulary and semantics defined by a base ontology model."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:TIOmodel
.

imo:Complies
  rdfs:label "Complies Class"@en ;
  rdfs:comment "The class imo:Complies represents a state transition event in the intent handling state machine. It indicates that the system got compliant to the requirements expressed by the Intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:Degrades
  rdfs:label "Degrades Class"@en ;
  rdfs:comment "The class imo:Degrades represents a state transition event in the intent handling state machine. It indicates that the system lost its compliance to the requirements expressed by the Intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:Event
  rdfs:label "Event Class"@en ;
  rdfs:comment "The class imo:Event represents an event of intent management within an intent management function. An event is also a subclass of t:Instance from the time ontology. This means it represents the point in time the event instance was issued by the intent manager."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf t:Instant
.

imo:event
  rdfs:label "Event Property"@en ;
  rdfs:comment "The property imo:event can be used to assign an intent handling event."@en ;
  rdf:type rdf:Property ;
  rdfs:range imo:IntentHandlingEvent
.

imo:eventFor
  rdfs:label "Event For Property"@en ;
  rdfs:comment "The property imo:eventFor is used in the class definition of subclasses of imo:Event. It is therefore part of the defintion of new event types. It specifies the Intent instance the event of this class is supposed to be issued for. This intent instance will be reflected by the imo:eventIssuedFor property used with event instances."@en ;
  rdf:type rdf:Property ;
  rdfs:domain imo:Event ;
  rdfs:range rdf:Resource
.

imo:eventIssuedBy
  rdfs:label "Event Issued By Property"@en ;
  rdfs:comment "The property imo:eventIssuedBy refers to the instance of the intent management function that has issued the intent."@en ; 
  rdf:type rdf:Property ;
  rdfs:domain imo:Event ;	
  rdfs:range imo:IntentManager
.

imo:eventIssuedFor
  rdfs:label "Event Issued For Property"@en ;
  rdfs:comment "The property imo:eventIssuedFor refers to the resource the event is generated for. This can for example be the intent instance the event was issued from the handling procedure for this intent and because of a situation reached concerning this intent."@en ;
  rdf:type rdf:Property ;
  rdfs:domain imo:Event ;
  rdfs:range rdf:Resource
.

imo:Handler
  rdfs:label "Handler Class"@en ;
  rdfs:comment "The class imo:Handler expresses that its instance has the role of intent handler in intent life-cycle management."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:LCMrole
.

imo:handler
  rdfs:label "Handler Property"@en ;
  rdfs:comment "The property imo:handler expresses that the resource of type imo:IntentManager in its object has the role of an intent handler for the subject. The subject is typically an intent or associated intent report."@en ;
  rdf:type rdf:Property ;
  rdfs:range imo:IntentManager
.

imo:HandlingEnded
  rdfs:label "Handling Ended Event"@en ;
  rdfs:comment "The class imo:HandlingEnded represents a state transition event in the intent handling state machine. It indicates that the intent handler has finished all tasks associated with the removal of the intent. This is typically the last event generated for an intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:handlingState
  rdfs:label "Handling State Property"@en ;
  rdfs:comment "The property imo:handlingState can be used to assign an intent handling state."@en ;
  rdf:type rdf:Property ;
  rdfs:range imo:IntentHandlingState
.

imo:handlingStateOf
  rdfs:label "Handling State Of Function"@en ;
  rdfs:comment "The function imo:handlingStateOf represents the current state in the intent handling state machine for the handling of the intent in the function argument."@en ;
  rdf:type fun:Function ;
  fun:resultType imo:IntentHandlingState ;
  fun:arityMin 1 ;
  fun:arityMax 1 ;
  fun:argumentTypes ( icm:Intent )
.

imo:IntentAccepted
  rdfs:label "Intent Accepted Event"@en ;
  rdfs:comment "The class imo:IntentAccepted represents a state transition event in the intent handling state machine. It indicates that the intent is accepted by the intent handler."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:IntentCommonModel
  rdfs:label "Intent Common Model Class"@en ;
  rdfs:comment "The class imo:IntentCommonModel is a subclass of imo:TIOmodel. Its instances are intent common models within the TM Forum Intent Ontology."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:TIOmodel
.

imo:IntentExtensionModel
  rdfs:label "Intent Extension Model Class"@en ;
  rdfs:comment "The class imo:IntentExtensionModel is a subclass of imo:TIOmodel. Its instances are an intent extension model within the TM Forum Intent Ontology."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:TIOmodel
.

imo:IntentHandlingEvent
  rdfs:label "Intent Handling Event Class"@en ;
  rdfs:comment "The class imo:intentHandlingEvent represents events of the intent handling and intent update state machines."@en ; 
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:Event
.

imo:IntentHandlingState
  rdfs:label "Intent Handling State Class"@en ;
  rdfs:comment "The class imo:IntentHandlingState is the class of all individuals that represent states of the intent handler."@en ;
  rdf:type rdfs:Class ;
.

imo:IntentManager
  rdfs:label "Intent Manager Class"@en ;
  rdfs:comment "The class imo:IntentManager expresses that its instance is an Intent Management Function."@en ;
  rdf:type rdfs:Class ;
.

imo:IntentReceived
  rdfs:label "Intent Received Event"@en ;
  rdfs:comment "The class imo:IntentReceived represents a state transition event in the intent handling state machine. It indicates that a new intent was received and that handling of this intent is starting."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:IntentRejected
  rdfs:label "Intent Rejected Event"@en ;
  rdfs:comment "The class imo:IntentRejected represents a state transition event in the intent handling state machine. It indicates that the intent handler has rejected the intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:IntentRemoval
  rdfs:label "Intent Removal Event"@en ;
  rdfs:comment "The class imo:IntentRemoval represents a state transition event in the intent handling state machine. It indicates that the intent owner has ordered a removal of the intent."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:LCMrole
  rdfs:label "LCM Role Class"@en ;
  rdfs:comment "The class imo:LCMrole expresses that its instance has a role in intent life-cycle management. Its subclasses specify which role that is."@en ;
  rdf:type rdfs:Class
.

imo:Now
  rdfs:label "Now"@en ;
  rdfs:comment "The property imo:now is an instance of class t:Instant specified in the Time Ontology in OWL [owltime]. It represents the current date and time."@en ;
  rdf:type t:Instant
.

imo:Owner
  rdfs:label "Owner Class"@en ;
  rdfs:comment "The class imo:Owner expresses that its instance has the role of intent owner in intent life-cycle management."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:LCMrole
.

imo:owner
  rdfs:label "Owner Property"@en ;
  rdfs:comment "The property imo:owner expresses that the resource of type imo:IntentManager in its object has the role of an intent owner for the subject. The subject is typically an intent or associated intent report."@en ;
  rdf:type rdf:Property ;
  rdfs:range imo:IntentManager
.

imo:StateCompliant
  rdfs:label "Compliant State"@en ;
  rdfs:comment "The individual imo:StateCompliant represents a state in the intent handling state machine. It indicates that the system is currently compliant to all requirements in the intent."@en ;
  rdf:type imo:IntentHandlingState
.

imo:StateDegraded
  rdfs:label "Degraded State"@en ;
  rdfs:comment "The individual imo:StateDegraded represents a state in the intent handling state machine. It indicates that the system is currently not compliant to all requirements in the intent."@en ;
  rdf:type imo:IntentHandlingState
.

imo:StateFinalizing
  rdfs:label "Finalizing State"@en ;
  rdfs:comment "The individual imo:StateFinalizing represents a state in the intent handling state machine. It indicates that the intent handler has stopped operating with the intent and is performing final clean-up tasks. This typically happens after the intent owner has ordered a removal of the intent."@en ;
  rdf:type imo:IntentHandlingState
.

imo:StateIntentReceived
  rdfs:label "Intent Received State"@en ;
  rdfs:comment "The individual imo:StateIntentReceived represents a state in the intent handling state machine. It indicates that a new intent has been received, and the intent handler is considering its acceptance."@en ;
  rdf:type imo:IntentHandlingState
.

imo:StateNoUpdate
  rdfs:label "No Update State"@en ;
  rdfs:comment "The individual imo:StateNoUpdate represents a state in the intent update state machine. The intent handler assumes this state while there is no update ongoing. It is a waiting state indicating an idle update state machine."@en ;
  rdf:type imo:IntentHandlingState
.

imo:StateUpdateReceived
  rdfs:label "Update Received State"@en ;
  rdfs:comment "The individual imo:StateUpdateReceived represents a state in the intent update state machine. This state indicates that the intent handler has received an update and is assessing if it can accept it or not."@en ;
  rdf:type imo:IntentHandlingState
.

imo:TIOmodel
  rdfs:label "TIO Model Class"@en ;
  rdfs:comment "The class imo:TIOmodel expresses that its instance is an ontology model within the TM Forum Intent Ontology"@en ;
  rdf:type rdfs:Class
.

imo:StateUpdating
  rdfs:label "Updateing State"@en ;
  rdfs:comment "The individual imo:StateUpdating represents a state in the intent update state machine. This state indicates that the intent handler has accepted the update and is replacing the requirements to be considered with the new version. "@en ;
  rdf:type imo:IntentHandlingState
.

imo:timeOfLastEventFor
  rdfs:label "Time Of Last Event Function"@en ;
  rdfs:comment "The function imo:timeOfLastEventFor represents the point in time when the last event of the specified event type was generated for an intent. The first argument specifies the event type and the second argument specifies the event instance. If no event of this type was issued yet for the intent, the reception of the intent is used as last event time. This means there is always a time provided. "@en ;
  rdf:type fun:Function ;
  fun:resultType t:Instant ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( imo:Event icm:Intent )
.

imo:timeOfLastEventsFor
  rdfs:label "Time Of Last Events For Function"@en ;
  rdfs:comment "The function imo:timeOfLastEventsFor represents the point in time when the last event of the specified event types was generated for an intent. The first argument specifies a container. Its members represent the event types to be considered. The second argument specifies the intent instance for which the events were issued. If no event of these types was issued yet for the intent, the reception of the intent is used as last event time. This means there is always a time provided."@en ;
  rdf:type fun:Function ;
  fun:resultType t:Instant ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( imo:Container icm:Intent )
.

imo:timeOfLastReportFor
  rdfs:label "Time Of Last Report For Function"@en ;
  rdfs:comment "The function imo:timeOfLastReportFor represents the point in time when the last intent report was generated for the intent specified in the function argument. If no report was issued yet, the reception of the intent is used as last report time. This means there is always a time provided."@en ;
  rdf:type fun:Function ;
  fun:resultType t:Instant ;
  fun:arityMin 1 ;
  fun:arityMax 1 ;
  fun:argumentTypes ( icm:Intent )
.

imo:UpdateAccepted
  rdfs:label "Update Accepted Event"@en ;
  rdfs:comment "The class imo:UpdateAccepted represents a state transition event in the intent update state machine. This event indicates that the update was accepted and the intent handler proceeds with replacing the intent content. The update state imo:StateUpdating is reached."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:UpdateFinished
  rdfs:label "Update Finished Event"@en ;
  rdfs:comment "The class imo:UpdateFinished represents a state transition event in the intent update state machine. This event indicates that the intent handler has finished executing a successful update. The update state machine returns to its waiting state imo:StateNoUpdate."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent

.

imo:UpdateReceived
  rdfs:label "Update Received Event"@en ;
  rdfs:comment "The class imo:UpdateReceived represents a state transition event in the intent update state machine. This event indicates that update handling is initiated, and the intent handler is assessing if it can accept the update. The update state machine has entered the state imo:StateUpdateReceived."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:UpdateRejected
  rdfs:label "Update Received Event"@en ;
  rdfs:comment "The class imo:UpdateRejected represents a state transition event in the intent update state machine. This event indicates that the update was rejected, and the intent handler continues with the previous version of the intent. The new version of the intent is discarded and the update state returns to imo:StateNoUpdate."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

imo:updateState
  rdfs:label "update State Property"@en ;
  rdfs:comment "The property imo:updateState can be used to assign an intent update state"@en ;
  rdf:type rdf:Property ;
  rdfs:range imo:IntentHandlingState
.

imo:updateStateOf
  rdfs:label "Update State Of Function"@en ;
  rdfs:comment "The function imo:updateStateOf represents the current state in the intent handling state machine for the handling of an update of the intent in the function argument"@en ;
  rdf:type fun:Function ;
  fun:resultType imo:IntentHandlingState ;
  fun:arityMin 1 ;
  fun:arityMax 1 ;
  fun:argumentTypes ( icm:Intent ) 
.

imo:Vocabulary
  rdfs:label "Intent Managment Vocabulary"@en ;
  rdfs:comment "The object imo:Vocabulary is a container of all model elements"@en ;
  rdf:type rdfs:Container ;
  rdfs:member imo:associatedValueCombination ,
              imo:associatedValueType ,
              imo:BaseOntologyModel ,
              imo:Complies ,
              imo:Degrades ,
              imo:Event ,
              imo:event ,
              imo:eventFor ,
              imo:eventIssuedBy ,
              imo:eventIssuedFor ,
              imo:Handler ,
              imo:handler ,
              imo:HandlingEnded ,
              imo:handlingState ,
              imo:handlingStateOf ,
              imo:IntentAccepted ,
              imo:IntentCommonModel ,
              imo:IntentExtensionModel ,
              imo:IntentHandlingEvent ,
              imo:IntentHandlingState ,
              imo:IntentManager ,
              imo:IntentReceived ,
              imo:IntentRejected ,
              imo:IntentRemoval ,
              imo:LCMrole ,
              imo:Now ,
              imo:Owner ,
              imo:owner ,
              imo:StateCompliant ,
              imo:StateDegraded ,
              imo:StateFinalizing ,
              imo:StateIntentReceived ,
              imo:StateNoUpdate ,
              imo:StateUpdateReceived ,
              imo:TIOmodel ,
              imo:StateUpdating ,
              imo:timeOfLastEventFor ,
              imo:timeOfLastEventsFor ,
              imo:timeOfLastReportFor ,
              imo:UpdateAccepted ,
              imo:UpdateFinished ,
              imo:UpdateReceived ,
              imo:UpdateRejected ,
              imo:updateState ,
              imo:updateStateOf
.

# Intent Probing v3.6.0

@prefix pro:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentProbing/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentProbing/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Intent Probing Model"@en ;
  rdfs:Comment "This model introduces the vocabulary for requesting and providing proposals for intent requirements."@en ;
  dct:title "Intent Probing Model"@en ;
  dct:description "This model introduces the vocabulary for requesting and providing proposals for intent requirements."@en ;
  dct:subject "intent probing"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentProbing/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentProbing/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291b-intent-probing-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

pro:expectedObservation
  rdfs:label "Expected Observation Property"@en ;
  rdfs:comment "The property pro:expectedObservation states predicted values for metrics rather than actually observed ones."@en ;
  rdf:type rdf:Property ;
  rdfs:range met:Observation
.

pro:expectedResult
  rdfs:label "Expexted Result Property"@en ;
  rdfs:comment "The property pro:expectedResult is used to state the predicted evaluation result for a probed intent."@en ;
  rdf:type rdf:Property ;
  rdfs:domain xsd:Boolean
.

pro:Vocabulary
  rdfs:label "Intent Probing Vocabulary"@en ;
  rdfs:comment "The object pro:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member pro:expectedObservation ,
              pro:expectedResult
.
# Intent Specification Model v3.6.0

@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/>
  rdf:type imo:TIOmodel ;
  rdfs:label "IntentSpecification"@en ;
  rdfs:Comment "An intent specification defines rules and constraints regarding allowed content of intent expressions."@en ;
  dct:title "IntentSpecification"@en ;
  dct:description "An intent specification defines rules and constraints regarding allowed content of intent expressions."@en ;
  dct:subject "intent specification"@en ,
              "intent template"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentSpecification/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr299-intent-specification-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

insp:allowedValues
  rdfs:label "Allowed Values Property"@en ;
  rdfs:comment "The property insp:allowedValues is used to specify the set of candidate objects or values to choose from for substituting the object template in its domain within a conforming intent expression."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ObjectTemplate ;
  rdfs:range rdfs:Container
.

insp:alternative
  rdfs:label "Alternative Property"@en ;
  rdfs:comment "The property insp:alternative specifies alternative content within intent specifications. Its range contains a list of all content templates representing viable alternatives. Each content template in the list alternative represents a statement or set of statements. Exactly one of these content templates and its statements needs to be used in place of insp:alternative when expressing an intent. This means a conforming intent expression must include a set of statements for every inst:alternative statement in the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:range insp:ContentTemplate
.

insp:applicableIf
  rdfs:label "Applicable If Property"@en ;
  rdfs:comment "The property insp:applicableIf specifies that the content template in its domain is applicable to the intent expression if the condition in its range evaluates to true."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ContentTemplate ;
  rdfs:range log:Condition
.

insp:applicableIfNot
  rdfs:label "Applicable If Not Property"@en ;
  rdfs:comment "The property insp:applicableIfNot specifies that the content template in its domain is applicable to the intent expression if the condition in its range evaluates to false."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ContentTemplate ;
  rdfs:range log:Condition
.

insp:availableVocabulary
  rdfs:label "Available Vocabulary Property"@en ;
  rdfs:comment "The property insp:availableVocabulary assigns a vocabulary template to an intent within an intent specification. It implies that the intent and all its elements can only be expressed using the vocabulary specified by the vocabulary template. Multiple insp:availableVocabulary assigned to the same subject are interpreted as union of the individual vocabulary templates."@en ;
  rdf:type rdf:Property ;
  rdfs:range insp:VocabularyTemplate
.

insp:chosenAll
  rdfs:label "Chosen All Function"@en ;
  rdfs:comment "The operator insp:chosenAll indicates true, if all content templates referred to by its arguments were chosen."@en ;
  rdfs:comment "<xsd:boolean> = insp:chosenAll ( <insp:ContentTemplate> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 1 ;
  fun:argumentTypes ( insp:ContentTemplate ) 
.

insp:chosenAllFor
  rdfs:label "Chosen All For Function"@en ;
  rdfs:comment "The operator insp:chosenAllFor indicates true, if for the intent element instance given as first argument all content templates referred to by its second and further arguments were chosen."@en ;
  rdfs:comment "<xsd:boolean> = insp:chosenAllFor ( <intent element> <insp:ContentTemplate> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Resource insp:ContentTemplate ) ;
  rdfs:Comment "The first argument is of type rdfs:Resource. It is referring to an element of the intent. The second and remaining arguments have type insp:ContentTemplate."@en
.

insp:chosenAny
  rdfs:label "Chosen Any Function"@en ;
  rdfs:comment "The operator insp:chosenAny indicates true, if any of the content templates referred to by its arguments were chosen."@en ;
  rdfs:comment "<xsd:boolean> = insp:chosenAny ( <insp:ContentTemplate> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 1 ;
  fun:argumentTypes ( insp:ContentTemplate ) ;
  rdfs:comment "All arguments have type insp:ContentTemplate."@en
.

insp:chosenAnyFor
  rdfs:label "Chosen Any For Function"@en ;
  rdfs:comment "The operator insp:chosenAnyFor indicates true, if for the intent element instance given as first argument any of content templates referred to by its second and further arguments were chosen."@en ;
  rdfs:comment "<xsd:boolean> = insp:chosenAnyFor ( <intent element> <insp:ContentTemplate> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Resource insp:ContentTemplate ) ;
  rdfs:comment "The first argument is of type rdfs:Resource. It is referring to an element of the intent. The second and remaining arguments have type insp:ContentTemplate."@en
.

insp:chosenHandlingDomain
  rdfs:label "Chosen Handling Domain Property"@en ;
  rdfs:comment "The property insp:chosenHandlingDomain refers to a chosen target autonomous domain. The intent expression is generated from the intent specification to express the requirements for that autonomous domain."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric
.

insp:chosenIntentHandler
  rdfs:label "Chosen Intent Handler Property"@en ;
  rdfs:comment "The property insp:chosenIntentHandler refers to the instance of an intent manager within the chosen target autonomous domain. The intent expression is generated from the intent specification to be sent to this intent manager instance."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric 
.

insp:content
  rdfs:label "Content Property"@en ;
  rdfs:comment "The property insp:content assigns the statements represented by the content template. The node used in its range is the source of statements to be transferred into the intent expression. All statements in that node shall be transferred. If insp:content is used multiple times within a content template, their contributions are additive and the superset of statements is applied."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ContentTemplate
.

insp:contentUsing
  rdfs:label "Content Using Property"@en ;
  rdfs:comment "The property insp:contentUsing represents content that is expressed in accordance with vocabulary templates. If it is used as property of a content template and represents a choice regarding content to be used in an intent expression made by the process that assembles the intent. This content is chosen in accordance with available vocabulary according to the vocabulary template in its range."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ContentTemplate
.

insp:ContentTemplate
  rdfs:label "Content Template Class"@en ;
  rdfs:comment "Content templates are instances of class insp:ContentTemplate, which is a subclass of insp:Template."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf insp:Template
.

insp:contentUsing
  rdfs:label "Content Using Property"@en ;
  rdfs:comment "The property insp:contentUsing assigns content chosen according to a vocabulary template."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ContentTemplate ;
  rdfs:range insp:VocabularyTemplate
.

insp:intentHandlerVendor
  rdfs:label "Intent Handler Vendor Property"@en ;
  rdfs:comment "The property insp:intentHandlerVendor refers to the vendor of the intent manager that is chosen to be the handler of the Intent that is generated from the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric
.

insp:intentOwner
  rdfs:label "Intent Owner Property"@en ;
  rdfs:comment "The property insp:intentOwner refers to the intent manager that is assembling the intent from the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric
.

insp:intentOwnerDomain
  rdfs:label "Intent Owner Domain Property"@en ;
  rdfs:comment "The property insp:intentOwnerDomain refers to the autonomous domain of the intent manager that is assembling the intent from the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric
.

insp:intentOwnerVendor
  rdfs:label "Intent Owner Vendor Property"@en ;
  rdfs:comment "The property insp:intentOwnerVendor refers to the vendor of the intent manager that is assembling the intent from the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf met:metric
.

insp:IntentSpecification
  rdfs:label "Intent Specification Class"@en ;
  rdfs:comment "Intent specifications are instances of class insp:IntentSpecification. An intent is assembled in accordance to an intent specification by finding an intent expression that complies to all rules and constraints expressed by the intent specification."@en ;
  rdf:type rdfs:Class
.

insp:mandatory
  rdfs:label "Mandatory Property"@en ;
  rdfs:comment "The property insp:mandatory specifies a content template that represents a statement or sets of statements that must be included in an intent expression. Its range contains a content template instance of class insp:ContentTemplate. This content template determines the statements that must be used as substitute for the insp:mandatory statement in a conforming intent expression."@en ;
  rdf:type rdf:Property ;
  rdfs:range insp:ContentTemplate
.

insp:mandatoryIntent
  rdfs:label "mandatory Intent Property"@en ;
  rdfs:comment "The property insp:mandatoryIntent intent assigns intent expressions that must be used. This means an intent expression conforming to the intent specification must conform to this intent expression including all rules and dynamic content choices it allows."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:IntentSpecification ;
  rdfs:range icm:Intent
.

insp:mandatorySpecification
  rdfs:label "Mandatory Specification Property"@en ;
  rdfs:comment "The property insp:mandatorySpecification expresses that an eligible intent expression must conform to the intent specification provided in its range. This expresses, that the rules and constraints of that intent specification are mandatory for follow. Multiple statements using insp:mandatorySpecification with the same subject are in a conjunction (AND). This means an assembled intent expression must conform to all mandatory intent specifications."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:IntentSpecification ;
  rdfs:range insp:IntentSpecification
.

insp:ObjectTemplate
  rdfs:label "Object Template Class"@en ;
  rdfs:comment "An object template is an instance of class insp:ObjectTemplate, which is a subclass of insp:Template. Within intent specifications an object template can be used as substitute for any object within an intent expression."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf insp:Template
.

insp:option
  rdfs:label "Option Property"@en ;
  rdfs:comment "The property insp:option specifies a set of statements that can be used in an intent expression. The range of insp:option is a template of class insp:ContentTemplate. The statements and expressions of this content template would substitute the insp:option statement within a conforming intent expression if this option is chosen."@en ;
  rdf:type rdf:Property ;
  rdfs:range insp:ContentTemplate
.

insp:optionalIntent
  rdfs:label "Optional Intent Property"@en ;
  rdfs:comment "The property insp:optionalIntent assigns intent objects to an intent specification. An intent expression that resembles any of these intents conforms to the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:IntentSpecification ;
  rdfs:range icm:Intent
.

insp:optionalSpecification
  rdfs:label "Optional Specification Property"@en ;
  rdfs:comment "The property insp:optionalSpecification expresses that an intent expression can be assembled following the intent specifications provided in its range. Multiple statements using insp:optionalSpecification with the same subject are in a disjunction (OR). This means an intent expression conforms overall if it conforms to at least one and potentially several of the optional specifications."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:IntentSpecification ;
  rdfs:range insp:IntentSpecification
.

insp:selectValues
  rdfs:label "Select Values Function"@en ;
  rdfs:comment "The abstract function insp:selectValues represents a container of values that can be chosen to substitute an object template. The first argument of insp:selectValues is a variable that represents the values to be chosen. The second and further arguments are conditions that use the variable in its first argument to express condition statements. Every value possible for the variable in the first argument according to the conditions is a member of the resulting container. The conditions are in a conjunction. This means, a value needs to satisfy all conditions to be included in the result container."@en ;
  rdfs:comment "<rdfs:Container> = insp:selectValues ( <rdfs:Resource> <log:Condition> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Resource log:Condition ) ;
  rdfs:comment "The first argument is any rdfs:Resource. The second and further arguments are log:Condition."@en 
.

insp:Template
  rdfs:label "Template Class"@en ;
  rdfs:comment "Templates are instances of subclasses of class insp:Template."@en ;
  rdf:type rdfs:Class
.

insp:templateType
  rdfs:label "Template Type Property"@en ;
  rdfs:comment "The property insp:templateType specifies what type of object an object template instance is representing and substituting in an intent expression that conforms to the intent specification."@en ;
  rdf:type rdf:Property ;
  rdfs:domain insp:ObjectTemplate
.

insp:usedVocabularyFor
  rdfs:label "Used Vocabulary For Function"@en ;
  rdfs:comment "The function insp:usedVocabularyFor indicates true, if for expressing the intent element referred to by the first argument all vocabulary is used specified in any of the remaining arguments. The second and remaining arguments are containers with members that refer to distinct elements of intent expression vocabulary."@en ;
  rdfs:comment "<xsd:boolean> = insp:usedVocabularyFor ( <intent element> <rdfs:Container> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Resource rdfs:Container ) ;
  rdfs:comment "The first argument is of type rdfs:Resource. It is referring to an element of the intent. The second and remaining arguments have type rdfs:Container. They define the set of vocabulary the function is checking against."@en 
.

insp:valueSelected
  rdfs:label "Value Selected Function"@en ;
  rdfs:comment "The operator insp:valueSelected indicates true, if for the object template referred to by the first argument, the chosen value is a member of the containers provided as second or remaining arguments."@en ;
  rdfs:comment "<xsd:boolean> = insp:valueSelected ( <insp:ObjectTemplate> <rdfs:Container> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( insp:ObjectTemplate insp:ContentTemplate ) ; 
  rdfs:comment "The first argument is of type insp:ObjectTemplate. The second and remaining arguments have type insp:ContentTemplate."@en 
.

insp:valueSelectedFor
  rdfs:label "Value Selected For Function"@en ;
  rdfs:comment "The operator insp:valueSelectedFor indicates true, if certain values were chosen for the combination of an intent element and object template. The intent element to be considered is provided by the first argument and the object template is referred to by the second argument. The values to be checked are members of the containers provided by the third or remaining arguments."@en ;
  rdfs:comment "<xsd:boolean> = insp:valueSelectedFor ( <intent element> <insp:ObjectTemplate> <rdfs:Container> ... )"@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ; 
  fun:argumentTypes ( rdfs:Resource insp:ObjectTemplate insp:ContentTemplate ) ;
  rdfs:comment "The first argument is of type rdfs:Resource. It is referring to an element of the intent. The second argument is of type insp:ObjectTemplate. The third and remaining arguments have type insp:ContentTemplate."@en 
.

insp:Vocabulary
  rdfs:label "Intent Specification Vocabulary"@en ;
  rdfs:comment "The object insp:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member insp:allowedValues ,
              insp:alternative ,
              insp:applicableIf ,
              insp:applicableIfNot ,
              insp:availableVocabulary ,
              insp:chosenAll ,
              insp:chosenAllFor ,
              insp:chosenAny ,
              insp:chosenAnyFor ,
              insp:chosenHandlingDomain ,
              insp:chosenIntentHandler ,
              insp:content ,
              insp:contentUsing ,
              insp:ContentTemplate ,
              insp:contentUsing ,
              insp:intentHandlerVendor ,
              insp:intentOwner ,
              insp:intentOwnerDomain ,
              insp:intentOwnerVendor ,
              insp:IntentSpecification ,
              insp:mandatory ,
              insp:mandatoryIntent ,
              insp:mandatorySpecification ,
              insp:ObjectTemplate ,
              insp:option ,
              insp:optionalIntent ,
              insp:optionalSpecification ,
              insp:selectValues ,
              insp:Template ,
              insp:templateType ,
              insp:usedVocabularyFor ,
              insp:valueSelected ,
              insp:valueSelectedFor ,
              insp:VocabularyTemplate
.

insp:VocabularyTemplate
  rdfs:label "Vocabulary Template Class"@en ;
  rdfs:comment "A vocabulary template is an instance of class insp:VocabularyTemplate, which is a subclass of insp:Template. A vocabulary template is also a subclass of imo:Vocabulary, which is a subclass of rdfs:Container."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf insp:Template ;
  rdfs:subClassOf imo:Vocabulary
.
# Intent Common Model v3.6.0

@prefix iv:   <http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Intent Validity Model"@en ;
  rdfs:Comment "The intent validity modelprovides the vocabulary for specifying the detailed conditions of validity within the intent expression."@en ;
  dct:title "Intent Validity Model"@en ;
  dct:description "The intent validity modelprovides the vocabulary for specifying the detailed conditions of validity within the intent expression."@en ;
  dct:subject "intent validity"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/IntentValidityOntology/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-15"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-15"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291a-intent-validity-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-15 - initial draft of turtle file"@en 
.

iv:isValid
  rdfs:label "Is Valid Property"@en ;
  rdfs:comment "The property iv:isValid is used to state the validity status of its object. It is used in intent reports. This means it states the validity at the time of report generation. The range of iv:isValid contains a Boolean literal value. It is set to true, if the object is valid and false if not."@en ;
  rdf:type rdf:Property ;
  rdfs:range xsd:Boolean
.

iv:sameValidityAs
  rdfs:label "Same Validity As Property"@en ;
  rdfs:comment "The property iv:sameValidityAs specifies that the validity of the subject shall be the same as the validity of the object."@en ;
  rdf:type rdf:Property 
.

iv:validIf
  rdfs:label "Valid If Property"@en ;
  rdfs:comment "The property iv:validIf assigns validity context to objects."@en ;
  rdf:type rdf:Property ;
  rdf:subPropertyOf: icm:context ;
  rdfs:range iv:Validity
.

iv:Validity
  rdfs:label "Validty Context Class"@en ;
  rdfs:comment "The class iv:Validity is a subclass of icm:Context. It represents and determines the validity of resources it is associated with using the property iv:validIf ."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Context ;
  rdfs:subClassOf t:TemporalEntity
.

iv:ValidityChange
  rdfs:label "Validity Change Event"@en ;
  rdfs:comment "The class iv:ValidityChange is a subclass of imo:intentHandlingEvent and represents events issued if the validity status of a resource is changing."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf imo:IntentHandlingEvent
.

iv:ValidityChangeInvalid
  rdfs:label "Change to Invalid Event"@en ;
  rdfs:comment "The class iv:ValidityChange is a subclass of iv:ValidityChange and represents events issued if the validity status of a resource is changing to invalid."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf iv:ValidityChange
.

iv:ValidityChangeValid
  rdfs:label "Change to Valid Event"@en ;
  rdfs:comment "The class iv:ValidityChange is a subclass of iv:ValidityChange and represents events issued if the validity status of a resource is changing to valid."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf iv:ValidityChange
.

iv:validityOf
  rdfs:label "Validity Of Function"@en ;
  rdfs:comment "The property iv:validityOf is a function that states the validity status of its arguments. If all arguments are valid, then the result of iv:validityOf is true, if any resource used as argument is not valid the result of iv:validityOf is false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:Boolean ;
  fun:argumentTypes ( rdf:Resource )
.

iv:ValidityReport
  rdfs:label "Validity Report Class"@en ;
  rdfs:comment "Instances of class iv:ValidityReport are used in intent reports to provide reporting about validity context."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ContextReport
.

iv:ValidityReportingExpectation
  rdfs:label "Validity Reporting Expectation Class"@en ;
  rdfs:comment "A validity reporting expectation is an instance of class iv:ValidityReportingExpectation within an intent. A validity reporting expectation is chosen to request an intent report, if the intent report shall explicitly state the validity of intent elements."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ReportingExpectation
.

iv:validityStatus
  rdfs:label "Validity Status Class"@en ;
  rdfs:comment "If an intent report is generated for a validity reporting expectation it can contain iv:validityStatus properties associated with dedicated reports for intent elements. It provides the validity status at the time of report generation and regarding the intent element referred to with the property icm:about. The property iv:validityStatus assigns a boolean value. The value true means the intent element is valid and false means invalid."@en ;
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean
.

iv:valueIfNotValid
  rdfs:label "Value If Not Valid Property"@en ;
  rdfs:comment "The property iv:valueIfNotValid allows specifying a function result that shall be provided as a default for invalid functions."@en ;
  rdf:type rdf:Property 
.

iv:Vocabulary
  rdfs:label "Validity Model Vocabulary"@en ;
  rdfs:comment "The object iv:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member iv:isValid ,
              iv:sameValidityAs ,
              iv:validIf ,
              iv:Validity ,
              iv:ValidityChange ,
              iv:ValidityChangeInvalid ,
              iv:ValidityChangeValid ,
              iv:validityOf ,
              iv:ValidityReport ,
              iv:ValidityReportingExpectation ,
              iv:validityStatus ,
              iv:valueIfNotValid 
.





# Conditions and Logic Operators Ontology version 3.6.0

@prefix log:  <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .

<http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Conditions and Logical Operators Ontology"@en ;
  rdfs:Comment "The conditions and logical operators ontology model introduces a set of logical operators available for expressing logical relationships in intent modeling."@en ;
  dct:title "Conditions and Logical Operators Ontology"@en ;
  dct:description "The conditions and logical operators ontology model introduces a set of logical operators available for expressing logical relationships in intent modeling."@en ;
  dct:subject "logical operators"@en ,
              "condition expression"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/LogicalOperators/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292e-logical-operators-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en ;
  skos:changeNote "2024-10-09 - Correcting an error in the vocabulary reference of the specificaion document: In the defintion of the log:oneOf function the property that assigns a subclass is removed."@en ;
.

log:allOf
  rdfs:label "All Of Function"@en ;
  rdfs:comment "The function log:allOf represents a logical conjunction also known as AND logical operator. It evaluates to boolean true if all arguments are individually true, otherwise the result is false. If the list of arguments is empty the result is also false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:argumentTypes ( xsd:boolean )
.

log:anyOf
  rdfs:label "Any Of Function"@en ;
  rdfs:comment "The function log:anyOf represents a logical disjunction also known as OR logical operator if there are only two arguments. It evaluates to boolean true if any (at least one) of the arguments are true, otherwise the result is false. If the list of arguments is empty the result is also false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:argumentTypes ( xsd:boolean )
.

log:Condition
  rdfs:label "Condition Class"@en ;
  rdfs:comment "The class log:Condition expresses that its instance is specifying a condition statement with a boolean result."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:IntentElement
.

log:match
  rdfs:label "Match Function"@en ;
  rdfs:comment "The function log:match represents the boolean truth value of the statement triple in the function arguments. The first argument represents the subject, the second argument represents the predicate and the third argument represents the object of a statement. It is true, if and only if the statement represented by this triple is true in the current knowledge base. Closed world assumption applies. If no statement is given as arguments or if it is incomplete, the result is false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( rdfs:Resource rdf:Property rdfs:Resource )
.

log:matchAll
  rdfs:label "Match All Function"@en ;
  rdfs:comment "The function log:matchAll represents a boolean truth value from multiple statement triples. A constituent statement is formed by using a member of the container in the first function argument as subject. The constituent statement is completed with the predicate from the second argument and the resource from the third argument. Therefore, the function needs to evaluate as many statements as there are members in the subject container. The function is evaluated with a logical conjunction of constituent statements. The result is boolean true, if all the constituent statements is true. Closed world assumption applies. If no complete statement is given by the function arguments, the result is false. This is also the case if the subject container in the first argument is empty, thus no subject is specified."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( rdfs:Container rdf:Property rdfs:Resource )
.

log:matchAny
  rdfs:label "Match Any Function"@en ;
  rdfs:comment "The function log:matchAny represents a boolean truth value from multiple statement triples. A constituent statement is formed by using a member of the container in the first function argument as subject. The constituent statement is completed with the predicate from the second argument and the resource from the third argument. Therefore, the function needs to evaluate as many statements as there are members in the subject container. The function is evaluated with a logical disjunction of constituent statements. The result is boolean true, if any of the constituent statements is true. Closed world assumption applies. If no complete statement is given by the function arguments, the result is false. This is also the case if the subject container in the first argument is empty, thus no subject is specified."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( rdfs:Container rdf:Property rdfs:Resource )
.

log:matchNone
  rdfs:label "Match None Function"@en ;
  rdfs:comment "The function log:matchNone represents a boolean truth value from multiple statement triples. A constituent statement is formed by using a member of the container in the first function argument as subject. The constituent statement is completed with the predicate from the second argument and the resource from the third argument. Therefore, the function needs to evaluate as many statements as there are members in the subject container. The function is evaluated with a logical negation of constituent statements. The result is boolean true, if none of the constituent statements are true. Closed world assumption applies. If no complete statement is given by the function arguments, the result is false. This is also the case if the subject container in the first argument is empty, thus no subject is specified."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( rdfs:Container rdf:Property rdfs:Resource )
.

log:matchOne
  rdfs:label "Match One Function"@en ;
  rdfs:comment "The function log:matchOne represents a boolean truth value from multiple statement triples. A constituent statement is formed by using a member of the container in the first function argument as subject. The constituent statement is completed with the predicate from the second argument and the resource from the third argument. Therefore, the function needs to evaluate as many statements as there are members in the subject container. The function is evaluated with a logical exclusive disjunction of constituent statements. The result is boolean true, if exactly one of the constituent statements is true. Closed world assumption applies. If no complete statement is given by the function arguments, the result is false. This is also the case if the subject container in the first argument is empty, thus no subject is specified."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( rdfs:Container rdf:Property rdfs:Resource )
.

log:matchStatement
  rdfs:label "Match Statement Function"@en ;
  rdfs:comment "The function log:matchStatement represents the boolean truth value of the statement in the function argument. It is true, if and only if all statements in its arguments are true in the current knowledge base. Closed world assumption applies. If no statement is given as argument, the result is false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:argumentTypes ( rdf:Statement )
.

log:noneOf
  rdfs:label "None Of Function"@en ;
  rdfs:comment "The function log:noneOf represents an evaluation similar to logical negation. It evaluates to boolean true if all the arguments are false and to false is any of the arguments are true. If the list of arguments is empty the result is true."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:argumentTypes ( xsd:boolean )
.

log:oneOf
  rdfs:label "One Of Function"@en ;
  rdfs:comment "The function log:oneOf represents an exclusive disjunction also known as XOR logical operator if there are only two arguments. It evaluates to boolean true if exactly one of the arguments is true, otherwise the result is false. If the list of arguments is empty the result is also false."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:argumentTypes ( xsd:boolean )
.

log:Vocabulary
  rdfs:label "Logical Operators Vocabulary"@en ;
  rdfs:comment "The object log:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member log:allOf ,
              log:anyOf ,
              log:Condition ,
              log:match ,
              log:matchAll ,
              log:matchAny ,
              log:matchNone ,
              log:matchOne ,
              log:matchStatement ,
              log:noneOf ,
              log:oneOf
 .
# Mathematical Functions Definition and Collection Ontology version 3.6.0

@prefix mf:   <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

<http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Mathematical Functions Definition and Collection Ontology"@en ;
  rdfs:Comment "This ontology model defines a set of mathematical functions and vocabulary to manage value ranges and composite functions."@en ;
  dct:title "Mathematical Functions Definition and Collection Ontology"@en ;
  dct:description "This ontology model defines a set of mathematical functions and vocabulary to manage value ranges and composite functions."@en ;
  dct:subject "functions"@en ,
              "mathematical functions"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/MathFunctions/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292h-mathematical-functions-definition-and-collection-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en 
.

mf:c
  rdfs:label "Vertical Offset Parameter"@en ;
  rdfs:comment "The property mf:c assigns a vertical offset to a function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range quan:Quantity
.

mf:coefficients
  rdfs:label "Coefficients Parameter"@en ;
  rdfs:comment "The property mf:coefficients specifies the list of coefficients that define a polynomial function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range quan:Quantity
.

mf:input
  rdfs:label "Function Input"@en ;
  rdfs:comment "The property mf:input specifies the input value within a function argument."@en ; 
  rdf:type rdf:Property ;
  rdfs:domain fun:Function
.

mf:k
  rdfs:label "Logistic Growth Parameter"@en ;
  rdfs:comment "The property mf:k specifies the logistic growth of a logistic function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range quan:Quantity
.

mf:l
  rdfs:label "Vertical Stretch Parameter"@en ;
  rdfs:comment "The property mf:l assigns a vertical stretch to a function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range quan:Quantity
.

mf:logistic
  rdfs:label "Logistic Function"@en ;
  rdfs:comment "The property mf:logistic represents a logistic function."@en ;
  rdf:type fun:Function ;
  fun:argumentNames ( mf:input mf:k mf:l mf:c ) ;
  fun:argumentTypes ( quan:Quantity ) ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 
.

mf:map
  rdfs:label "Value Mapping Parameter"@en ;
  rdfs:comment "The property mf:map defines the mapping of input to result values applied in a mapping function. The range is a list with entries that are lists as well which represent individual mapping. The individual mapping lists have the result value as first entry and all other entries are values that are supposed to be mapped into this result."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range rdf:List
.

mf:mapping
  rdfs:label "Mapping Function"@en ;
  rdfs:comment "The property mf:mapping represents a mapping function."@en ;
  rdf:type fun:Function ;
  fun:argumentNames ( mf:input mf:map ) ;
  fun:argumentTypes ( rdf:Resource rdf:List ) ;
  fun:resultType rdf:Resource ;
  fun:arityMin 1 
.

mf:poly
  rdfs:label "Polynomial Function"@en ;
  rdfs:comment "The property mf:poly represents a polynomial function."@en ;
  rdf:type fun:Function ;
  fun:argumentNames ( mf:input mf:coefficients mf:l mf:c ) ;
  fun:argumentTypes ( quan:Quantity ) ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 
.

mf:Vocabulary
  rdfs:label "Math Function Vocabulary"@en ;
  rdfs:comment "The object mf:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member mf:c ,
              mf:coefficients ,
              mf:input ,
              mf:k ,
              mf:l ,
              mf:logistic ,
              mf:map ,
              mf:mapping ,
              mf:poly ,
              mf:x0
.

mf:x0
  rdfs:label "Horizontal Shift Parameter"@en ;
  rdfs:comment "The property mf:x0 assigns a horizontal shift to a function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain fun:Function ;
  rdfs:range quan:Quantity
.
# Metrics and Observations Ontology version 3.6.0

@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

<http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Metrics And Observations Ontology"@en ;
  rdfs:Comment "This ontology model introduces metrics and observations and specifies classes, properties and functions for defining and managing them."@en ;
  dct:title "Metrics And Observations Ontology"@en ;
  dct:description "This ontology model introduces metrics and observations and specifies classes, properties and functions for defining and managing them."@en ;
  dct:subject "metrics definition"@en ,
              "measurements"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/MetricsAndObservations/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292g-metrics-and-observations-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en 
.

met:lastObserved
  rdfs:label "Last Observed Function"@en ;
  rdfs:comment "The function met:lastObserved refers to the newest individual observation created for the metrics that are provided as function arguments. For example, it refers to latest measurement obtained for a latency."@en ;
  rdf:type fun:function ;
  fun:resultType met:Observation ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Metric )
.

met:lastValue
  rdfs:label "Last Value Function"@en ;
  rdfs:comment "The function met:lastValue refers to the newest observed value for a metric and provides the value as result."@en ;
  rdf:type fun:function ;
  fun:resultType rdf:Resource ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Metric )
.

met:metric
  rdfs:label "Metric Property"@en ;
  rdfs:comment "Sub-properties of  met:Metric represent observable and measurable items."@en ;
  rdf:type rdf:Property
.

met:Observation
  rdfs:label "Observation Class"@en ;
  rdfs:comment "An observation is a distinct value or fact that was observed or measured for a metric. An observation is represented by an individual of class met:Observation. They represent a measured or otherwise observed fact about a resource."@en ;
  rdf:type rdfs:Class
.

met:observed
  rdfs:label "Observed Property"@en ;
  rdfs:comment "The property met:observed can be used to assign an instance of class met:Observation to other objects."@en ;
  rdf:type rdf:Property ;
  rdfs:range met:Observation
.

met:observedMetric
  rdfs:label "Observed Metric Property"@en ;
  rdfs:comment "The property met:observedMetric states what was observed by an observation. This refers to a met:metric property that identifies a metric."@en ;
  rdf:type rdf:Property ;
  rdfs:domain met:Observation ;
  rdfs:range met:Metric
.

met:observedValue
  rdfs:label "Observed Value Function"@en ;
  rdfs:comment "The function met:observedValue refers to the value of an individual observation and provides this value as function result."@en ;
  rdf:type fun:function ;
  fun:resultType rdf:Resource ;
  fun:arityMin 1 ;  
  fun:arityMax 1 ;  
  fun:argumentTypes ( met:Observation ) 
.

met:obtainedAt
  rdfs:label "Obtained At Function"@en ;
  rdfs:comment "The property met:obtainedAt states the point in time when the observation was obtained and the observation individual was created in the knowledge base."@en ;
  rdf:type rdf:Property ;
  rdfs:domain met:Observation ;
.

met:Vocabulary
  rdfs:label "Metrics and Observation Vocabulary"@en ;
  rdfs:comment "The object met:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member met:lastObserved ,
              met:lastValue ,
              met:metric ,
              met:Observation ,
              met:observed ,
              met:observedMetric ,
              met:observedValue ,
              met:obtainedAt
.

# Preference Of Handling Outcomes v3.6.0

@prefix pre:  <http://tio.models.tmforum.org/tio/v3.6.0/PreferenceOfHandlingOutcomes/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/PreferenceOfHandlingOutcomes/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Preference Of Intent Handling Outcomes Model"@en ;
  rdfs:Comment "This intent extension model allows an intent handler ask intent owners for their preference regarding solution alternatives by presenting alternative outcomes."@en ;
  dct:title "Preference Of Intent Handling Outcomes Model"@en ;
  dct:description "This intent extension model allows an intent handler ask intent owners for their preference regarding solution alternatives by presenting alternative outcomes."@en ;
  dct:subject "intent outcome preference"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/PreferenceOfHandlingOutcomes/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/PreferenceOfHandlingOutcomes/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291g-preference-of-intent-handling-outcomes-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

pre:about
  rdfs:label "About Property"@en ;
  rdfs:comment "The property pre:about is a reference to the judgement request instance stated in the intent reports that are part of the judgement request."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range pre:JudgementRequest
.

pre:aboutOption
  rdfs:label "About Option Property"@en ;
  rdfs:comment "The property pre:aboutOption refers to the intent report, for which this preference score object states the score."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:PreferenceScore ;
  rdfs:range icm:IntentReport
.

pre:JudgementRequest
  rdfs:label "Judgement Request Class"@en ;
  rdfs:comment "The class pre:JudgementRequest represents a request from the intent handler to an intent owner to provide its preference regarding the expected results of available solution options on the intent requirements. It is a subclass of rdfs:Container with members that refer to intent reports requesting the expected outcomes for available options."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf  rdfs:Container
.

pre:judgementRequest
  rdfs:label "Judgement Request Property"@en ;
  rdfs:comment "The property pre:judgementRequest associates a judgement request of class pre:JudgementRequest with an intent report."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range pre:JudgementRequest
.

pre:maxScore
  rdfs:label "Max Score Property"@en ;
  rdfs:comment "The property pre:maxScore states the maximum value or full score used in providing preference scores. If not provided, the highest sore used within the preferences of this intent owner within this judgement request is considered to be the maximum score."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:ScoreInterpretation
.

pre:minScore
  rdfs:label "Min Score Property"@en ;
  rdfs:comment "The property pre:minScore states the minimum score value used in providing preference scores. If not provided, a minimum score of 0 is assumed by default."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:ScoreInterpretation
.

pre:neutral
  rdfs:label "Neutral Property"@en ;
  rdfs:comment "The property pre:neutral refers to an intent report the intent owner does not mind, but also does not express an explicit preference for. This is the assumed default for options without a dedicated preference statement. It is also assumed if the intent owner does not provide a preference statement before the preference deadline."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range icm:IntentReport
.

pre:objected
  rdfs:label "Objected Property"@en ;
  rdfs:comment "The property pre:objected refers to an intent report the intent owner considers problematic from its perspective. The respective solution should not be chosen by the intent handler."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range icm:IntentReport
.

pre:objectedThreshold
  rdfs:label "Objected Threshold Property"@en ;
  rdfs:comment "The property pre:objectedThreshold defines the maximum score for objected options. An option with lower than this score should be avoided."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:ScoreInterpretation
.

pre:Preference
  rdfs:label "Preference Class"@en ;
  rdfs:comment "The class pre:Preference represents preferences of an intent owner with respect to the options presented in a judgement request."@en ;
  rdf:type rdfs:Class
.

pre:preference
  rdfs:label "Preference Property"@en ;
  rdfs:comment "The property pre:preference associates a preference provided by an intent owner to an intent."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:Intent ;
  rdfs:range pre:Preference
.

pre:preferenceDeadline
  rdfs:label "Preference Deadline Property"@en ;
  rdfs:comment "The property pre:preferenceDeadline states the point in time until the preference needs to be provided. The intent handler waits for a preference statement provided by the intent owner until this point in time. If until then none or incomplete preference statements are received, the intent handler will proceed and select a solution with the information available."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:JudgementRequest ;
  rdfs:range t:Instant
.

pre:PreferenceScore
  rdfs:label "Preference Score Property"@en ;
  rdfs:comment "An instance of class pre:PreferenceScore is added to the preference object within the intent by the intent owner to present its preferences regarding an option and quantify its preference with a numerical score."@en ;
  rdf:type rdfs:Class
.

pre:preferred
  rdfs:label "Preferred Property"@en ;
  rdfs:comment "The property pre:preferred refers to an intent report the intent owner considers preferential. It is referring to an intent report presented by the judgement request."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range icm:IntentReport
.

pre:preferredThreshold
  rdfs:label "Preferred Threshold Property"@en ;
  rdfs:comment "The property pre:preferredThreshold defines the minimum score value for preferred options. An option with at least this score is considered to be preferred."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:ScoreInterpretation
.

pre:score
  rdfs:label "Score Property"@en ;
  rdfs:comment "The property pre:score associates a preference score to a preference."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range pre:PreferenceScore
.

pre:ScoreInterpretation
  rdfs:label "Score Interpretation Class"@en ;
  rdfs:comment "An instance of class pre:ScoreInterpretation is added to the preference object within the intent by the intent owner to provide further information about the interpretation of scores used when specifying preferences."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf  rdfs:Container
.

pre:scoreInterpretation
  rdfs:label "Score Interpretation Property"@en ;
  rdfs:comment "A score interpretation is associated with a preference using the property pre:scoreInterpretation."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:Preference ;
  rdfs:range pre:ScoreInterpretation
.

pre:scoreValue
  rdfs:label "Score Value Property"@en ;
  rdfs:comment "The property pre:scoreValue assigns a numerical value to the preference score object. This is the numerical score associated with an option."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pre:PreferenceScore
.

pre:Vocabulary
  rdfs:label "Preference Of Handling Outcomes Vocabulary"@en ;
  rdfs:comment "The object pre:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member pre:about ,
              pre:aboutOption ,
              pre:JudgementRequest ,
              pre:judgementRequest ,
              pre:maxScore ,
              pre:minScore ,
              pre:neutral ,
              pre:objected ,
              pre:objectedThreshold ,
              pre:Preference ,
              pre:preference ,
              pre:preferenceDeadline ,
              pre:PreferenceScore ,
              pre:preferred ,
              pre:preferredThreshold ,
              pre:score ,
              pre:ScoreInterpretation ,
              pre:scoreInterpretation ,
              pre:scoreValue 
.

# Proposal Best Intent v3.6.0

@prefix pbi:  <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Proposal Best Intent Model"@en ;
  rdfs:Comment "This model introduces the vocabulary for requesting and providing proposals for intent requirements."@en ;
  dct:title "Proposal Best Intent Model"@en ;
  dct:description "This model introduces the vocabulary for requesting and providing proposals for intent requirements."@en ;
  dct:subject "intent proposal"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/ProposalBestIntent/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291c-proposal-of-best-intent-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

pbi:BestProposalExpectation
  rdfs:label "Best Proposal Expectation Class"@en ;
  rdfs:comment "The class pbi:BestProposalExpectation is used to request proposals of best intent. It is a subclass of icm:ReportingExpectation, which also implies that the proposal is communicated through an intent report."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ReportingExpectation
.

pbi:BestProposalReport
  rdfs:label "Best Proposal Report Class"@en ;
  rdfs:comment "The class pbi:BestProposalReport is used to provide the proposals corresponding to a best proposal expectation in the intent. It is a subclass of icm:ExpectationReport."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:ExpectationReport
.

pbi:Proposal
  rdfs:label "Proposal Class"@en ;
  rdfs:comment "The class pbi:Proposal is used to provide an individual proposal. Typically, there a proposal created for every requirement in scope of a best proposal expectation as stated by its target."@en ;
  rdf:type rdfs:Class
.

pbi:proposal
  rdfs:label "Proposal Property"@en ;
  rdfs:comment "The property pbi:Proposal refers to the best intent proposals contained in the intent report."@en ;
  rdf:type rdf:Property ;
  rdfs:domain icm:IntentReport ;
  rdfs:range pbi:BestProposalReport
.

pbi:proposed
  rdfs:label "Proposed Property"@en ;
  rdfs:comment "The property pbi:proposed is used in the domain of a best proposal report to refer to an individual proposal."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pbi:BestProposalReport ;
  rdfs:range pbi:Proposal
.

pbi:proposedFor
  rdfs:label "Proposed For Property"@en ;
  rdfs:comment "The property pbi:proposedFor is used to state what requirement object from the intent the proposal is made for."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pbi:Proposal
.

pbi:proposedBest
  rdfs:label "Proposed Best"@en ;
  rdfs:comment "The property pbi:proposedBest refers to an object that states the proposed values."@en ;
  rdf:type rdf:Property ;
  rdfs:domain pbi:Proposal
.

pbi:Vocabulary
  rdfs:label "Proposal Best Intent Vocabulary"@en ;
  rdfs:comment "The object pbi:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member pbi:BestProposalExpectation ,
              pbi:BestProposalReport ,
              pbi:Proposal ,
              pbi:proposal ,
              pbi:proposed ,
              pbi:proposedFor ,
              pbi:proposedBest
.
# Quantity Ontology version 3.6.0

@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Quantity Ontology"@en ;
  rdfs:Comment "This ontology model defines quantities and a set of operator functions that allow to define, modify, combine and compare quantity objects. Quantities are objects that have a numerical value combined with a unit."@en ;
  dct:title "Quantity Defintion Ontology"@en ;
  dct:description "This ontology model defines quantities and a set of operator functions that allow to define, modify, combine and compare quantity objects. Quantities are objects that have a numerical value combined with a unit."@en ;
  dct:subject "quantity defintion"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/QuantityOntology/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292d-quantity-ontology-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en ;
.

quan:atLeast
  rdfs:label "At Least Function"@en ;
  rdfs:comment "The function quan:atLeast defines a comparison of quantities. It provides a boolean result and is evaluated as 'true' if the quantity of the first argument is equal to or bigger than the quantity of the second argument. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:atMost
  rdfs:label "At Most Function"@en ;
  rdfs:comment "The function quan:atMost defines a comparison of quantities. It provides a boolean result and is evaluated as 'true' if the quantity of the first argument is equal to or smaller than the quantity of the second argument. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:difference
  rdfs:label "Difference Function"@en ;
  rdfs:comment "The function quan:difference defines a mathematical operation that provides the numerical difference between two quantities. It has two arguments, and it evaluates to the difference of the first argument value minus the second argument value. Unit prefixes are considered in the calculation. The unit expression of the first argument is used for the result."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:division
  rdfs:label "Division Function"@en ;
  rdfs:comment "The function quan:division defines a mathematical operation that provides the result of a division of two quantities. The first argument is the numerator and the second the denominator of the division. The function therefore has exactly two arguments. Unit prefixes are considered in the calculation. Both arguments can have different units and the unit expression of the result is generated based on the units of the arguments."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:exactly
  rdfs:label "Exactly Function"@en ;
  rdfs:comment "The function quan:exactly defines a comparison of quantities. It provides a boolean result and is evaluated as 'true' if the quantity of all arguments are the same. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:greater
  rdfs:label "Greater Function"@en ;
  rdfs:comment "The function quan:greater defines a comparison of quantities. It provides a boolean result and is evaluated as true if the quantity of the first argument is greater than the quantity of the second argument. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:arityMax 2 ; 
  fun:argumentTypes ( quan:Quantity )
.

quan:greatest
  rdfs:label "Greatest Function"@en ;
  rdfs:comment "The function quan:greatest provides a result that is the largest quantity across all quantities provided as arguments. If no argument is provided the result has value 0 without unit. Units and unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:argumentTypes ( quan:Quantity )
.

quan:greatestInSet
  rdfs:label "Greatest In Set Function"@en ;
  rdfs:comment "The function quan:greatestInSet provides a result that is the largest quantity across all quantities across member elements of the union of all containers that are provided as arguments. If no argument is provided the result has value 0 without unit. Units and unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:argumentTypes ( rdfs:Container )
.

quan:inRange
  rdfs:label "In Range Function"@en ;
  rdfs:comment "The function quan:inRange defines a comparison of quantities. It provides a boolean result and is evaluated as 'true' if the value of the quantity of the first argument is equal to or greater than the quantity of the second argument and if it is equal to or smaller than the quantity of the third argument. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:arityMax 3 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:MonetaryQuantity
  rdfs:label "Monetary Quantity Class"@en ;
  rdfs:comment "The class quan:MonetaryQuantity refers to a quantity with currency based units."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf quan:Quantity
.

quan:mean
  rdfs:label "Mean Function"@en ;
  rdfs:comment "The function quan:mean defines a mathematical operation that provides the arithmetic mean of quantities. The function can have any number of arguments of type quan:Quantity and the result is the arithmetic mean across all of them. The result is 0 with no unit if no argument is provided. If only one argument is given, then the result is identical with the argument. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first argument."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:meanOfSet
  rdfs:label "Mean Of Set Function"@en ;
  rdfs:comment "The function quan:meanOfSet defines a mathematical operation that provides the arithmetic mean of quantities. The function can have any number of arguments of type rdfs:Container and the result is the arithmetic mean across all member elements of the union of these containers. The result is 0 with no unit if no member element of type quan:quantity is provided by any of the argument containers. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first member element processed from the first argument container."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Container )
.

quan:median
  rdfs:label "Median Function"@en ;
  rdfs:comment "The function quan:median defines a mathematical operation that provides the median value of quantities. The function can have any number of arguments of type quan:Quantity and the result is the arithmetic median value across all of them. The result is 0 with no unit if no argument is provided. If only one argument is given, then the result is identical with the argument. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first argument."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:medianOfSet
  rdfs:label "Median Of Set Function"@en ;
  rdfs:comment "The function quan:medianOfSet defines a mathematical operation that provides the median value of quantities. The function can have any number of arguments of type rdfs:Container and the result is the median value across all member elements of the union of these containers. The result is 0 with no unit if no member element of type quan:quantity is provided by any of the argument containers. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first member element processed from the first argument container."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Container )
.

quan:multiplication
  rdfs:label "Multiplication Function"@en ;
  rdfs:comment "The function quan:multiplication defines a mathematical operation that provides the result of a multiplication of quantities. The function can have any number of arguments of type quan:Quantity and the result is the multiplication of all of them. The result is 0 with no unit if no argument is provided. If only one argument is given, then the result is identical with the argument. Units and unit prefixes are considered in the calculation. The result unit depends on the unit of contributing quantities and a suitable unit will be assigned."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:multiplicationOfSet
  rdfs:label "Multiplication Of Set Function"@en ;
  rdfs:comment "The function quan:multiplicationOfSet defines a mathematical operation that provides the result of a multiplication of quantities. The function can have any number of arguments of type rdfs:Container and the result is the multiplication of all member elements of the union of these containers. The result is 0 with no unit if no member element of type quan:Quantity is provided by any of the argument containers. Units and unit prefixes are considered in the calculation. The result unit depends on the unit of contributing quantities and a suitable unit will be assigned."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Container )
.

quan:Quantity
  rdfs:label "Quantity Class"@en ;
  rdfs:comment "The class quan:Quantity defines a structured datatype for representing a numerical value in combination with a unit expression."@en ;
  rdf:type rdfs:Class
.

quan:quantity
  rdfs:label "Quantity Datatype"@en ;
  rdfs:comment "The datatype quan:quantity is a string that contains a combination of numerical value and unit. A literal of this datatype is equivalent to an individual of class quan:Quantity with value and unit specified separately through the properties rdf:value and quan:unit."@en ;
  rdf:type rdfs:Datatype

.

quan:smaller
  rdfs:label "Smaller Function"@en ;
  rdfs:comment "The function quan:smaller defines a comparison of quantities. It provides a boolean result and is evaluated as true if the quantity of the first argument is smaller than the quantity of the second argument. Unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:arityMax 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:smallest
  rdfs:label "Smallest Function"@en ;
  rdfs:comment "The function quan:smallestInSet provides a result that is the smallest quantity across all quantities provided as arguments. If no argument is provided the result has value 0 without unit. Units and unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:argumentTypes ( quan:Quantity ) 
.

quan:smallestInSet
  rdfs:label "Smallest In Set Function"@en ;
  rdfs:comment "The function quan:smallestInSet provides a result that is the smallest quantity across all quantities across member elements of the union of all containers that are provided as arguments. If no argument is provided the result has value 0 without unit. Units and unit prefixes are considered."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:argumentTypes ( rdfs:Container )
.

quan:sum
  rdfs:label "Sum Function"@en ;
  rdfs:comment "The function quan:sum defines a mathematical operation that provides the result of an addition of quantities. The function can have any number of arguments of type quan:Quantity and the result is the sum of all of them. The result is 0 with no unit if no argument is provided. If only one argument is given, then the result is identical with the argument. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first argument."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 2 ;
  fun:argumentTypes ( quan:Quantity )
.

quan:sumOfSet
  rdfs:label "Sum Of Set Function"@en ;
  rdfs:comment "The function quan:sumOfSet defines a mathematical operation that provides the result of an addition of quantities. The function can have any number of arguments of type rdfs:Container and the result is the sum of all member elements of the union of these containers. The result is 0 with no unit if no member element of type quan:quantity is provided by any of the argument containers. Units and unit prefixes are considered in the calculation. The arguments must have units that are of the same dimension and the unit assigned to the result is the unit of the first member element processed from the first argument container."@en ;
  rdf:type fun:Function ;
  fun:resultType quan:Quantity ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Container )
.

quan:unit
  rdfs:label "Unit Property"@en ;
  rdfs:comment "The property quan:unit assigns a unit to a quantity."@en ;
  rdf:type rdf:Property ;
  rdfs:domain quan:Quantity ;
  rdfs:range xsd:string
.

quan:Vocabulary
  rdfs:label "Quantity Vocabulary"@en ;
  rdfs:comment "The object quan:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member quan:atLeast ,
              quan:atMost ,
              quan:difference ,
              quan:division ,
              quan:exactly ,
              quan:greater ,
              quan:greatest ,
              quan:greatestInSet ,
              quan:inRange ,
              quan:MonetaryQuantity ,
              quan:mean ,
              quan:meanOfSet ,
              quan:median ,
              quan:medianOfSet ,
              quan:multiplication ,
              quan:multiplicationOfSet ,
              quan:Quantity ,
              quan:quantity ,
              quan:smaller ,
              quan:smallest ,
              quan:smallestInSet ,
              quan:sum ,
              quan:sumOfSet ,
              quan:unit 
.

# Set Operators Ontology version 3.6.0

@prefix set:  <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t:    <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

<http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/>
  rdf:type imo:BaseOntologyModel ;
  rdfs:label "Set Operators Ontology"@en ;
  rdfs:Comment "This ontology model introduces set operators. They allow to contruct sets and draw inference from sets when used in condition expressions."@en ;
  dct:title "SetOperators Ontology"@en ;
  dct:description "This ontology model introduces set operators. They allow to contruct sets and draw inference from sets when used in condition expressions."@en ;
  dct:subject "set operators"@en ,
              "condition expression"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/SetOperators/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-09"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-09"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr292f-set-operators-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-09 - initial draft of turtle file"@en 
.

set:difference
  rdfs:label "Diffrence Function"@en ;
  rdfs:comment "The function set:difference represents a container of all members of the first argument container, which are not members of the other given containers as well. If no argument is given, the resulting container is empty. If only one argument is given, the resulting container is identical to the argument."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Container )
.

set:elementOf
  rdfs:label "Element Of Function"@en ;
  rdfs:comment "The function set:elementOf represents the result of an evaluation. It assumes the boolean type result value true, if the resource given in the first argument is a member of all the containers given by the remaining arguments."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Resource rdfs:Container )
.

set:empty
  rdfs:label "Empty Function"@en ;
  rdfs:comment "The function set:empty represents the result of an evaluation. It assumes the boolean type result value true, if none of the containers given as arguments has any members."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 1 ;
  fun:argumentTypes ( rdfs:Container )
.

set:forAll
  rdfs:label "For All Function"@en ;
  rdfs:comment "The function set:forAll has at least three arguments. The first argument represents any individual member from the container provided in the second argument. The third and all following arguments are resources with Boolean value. This can for example be a function that evaluates to a Boolean result. The function set:forAll has a Boolean type result directly derived from the third argument. The set:forAll function replicates the evaluation of the third argument for every member of the second argument. This allows to express that a condition set by the third argument needs to be met by every member of the provided container. The first argument is a resource use do represent individual members of the container. It can be used in the expression of the condition or evaluation specified by the third argument."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 3 ;
  fun:argumentTypes ( rdf:Resource rdfs:Container rdf:Resource)
.

set:includedIn
  rdfs:label "Included In Function"@en ;
  rdfs:comment "The function set:includedIn represents the result of an evaluation. It assumes the boolean type result value true, if all members of the container in the first argument are also members of each container given by the remaining arguments."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Container )
.

set:intersection
  rdfs:label "Intersection Function"@en ;
  rdfs:comment "The function set:intersection represents a container of only those resources that are members of all containers specified in the arguments. If no arguments are given, the resulting container is empty. If only one argument is given, the resulting container is identical to the argument."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Container )
.

set:intersectsWith
  rdfs:label "Intersects With Function"@en ;
  rdfs:comment "The function set:intersectsWith represents the result of an evaluation. It assumes the boolean type result value true, if there are member objects in the first argument container that are also members in all other containers given as arguments."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ; 
  fun:argumentTypes ( rdfs:Container ) 
.

set:isMember
  rdfs:label "Is Member Function"@en ;
  rdfs:comment "The function set:isMember has at least two arguments. It provides the result true if the resource provided as first argument is a member of any container provided by the remaining arguments."@en ;
  rdf:type fun:Function ;
  fun:resultType xsd:boolean ;
  fun:arityMin 2 ; 
  fun:argumentTypes ( rdf:Resource rdfs:Container ) 
.

set:membersAfter
  rdfs:label "members After Function"@en ;
  rdfs:comment "The function set:membersAfter represents the result of a time based container member filtering. The first parameter refers to the property of a member that assigns a time-stamp to a member object. This is the timestamp to be used in the evaluation of this function. The second parameter specifies a point in time expressed as individual of the class t:Instant defined in the time ontology in OWL [owltime]. The third and all remaining parameters are containers. The function provides a container as result. The members of this result container are members of the union of all containers provided as parameters, which meet the condition that their time stamp is after the time stamp provided as second parameter. The property provided as first parameter is the one used to evaluate the condition. This property needs to be used for a member of the input containers for the member object to be considered in the evaluation and included in the result."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 3 ;
  fun:argumentTypes ( rdf:Property t:Instance rdfs:Container )
.

set:membersBefore
  rdfs:label "membersBefore Function"@en ;
  rdfs:comment "The function set:membersBefore represents the result of a time based container member filtering. The first parameter refers to the property of a member that assigns a time-stamp to a member object. This is the timestamp to be used in the evaluation of this function. The second parameter specifies a point in time expressed as individual of the class t:Instant defined in the time ontology in OWL [owltime]. The third and all remaining parameters are containers. The function provides a container as result. The members of this result container are members of the union of all containers provided as parameters, which meet the condition that their time stamp is before the time stamp provided as second parameter. The property provided as first parameter is the one used to evaluate the condition. This property needs to be used for a member of the input containers for the member object to be considered in the evaluation and included in the result."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 3 ;
  fun:argumentTypes ( rdf:Property t:Instance rdfs:Container ) 
.

set:membersSameTime
  rdfs:label "Members Same Time Function"@en ;
  rdfs:comment "The function set:membersSameTime represents the result of a time based container member filtering. The first parameter refers to the property of a member that assigns a time-stamp to a member object. This is the timestamp to be used in the evaluation of this function. The second parameter specifies a point in time expressed as individual of the class t:Instant defined in the time ontology in OWL [owltime]. The third and all remaining parameters are containers. The function provides a container as result. The members of this result container are members of the union of all containers provided as parameters, which meet the condition that their time-stamp shows the same time as the time-stamp provided as second parameter. The property provided as first parameter is the one used to evaluate the condition. This property needs to be used for a member of the input containers for the member object to be considered in the evaluation and included in the result."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 3 ;
  fun:argumentTypes ( rdf:Property t:Instance rdfs:Container )
.

set:membersWhile
  rdfs:label "Members While Function"@en ;
  rdfs:comment "The function set:membersWhile represents the result of a time based container member filtering. The first parameter refers to the property of a member that assigns a time-stamp to a member object. This is the time-stamp to be used in the evaluation of this function. The second parameter specifies time interval in time expressed as individual of the class t:Interval defined in the time ontology in OWL [owltime]. The third and all remaining parameters are containers. The function provides a container as result. The members of this result container are members of the union of all containers provided as parameters, which meet the condition that their time-stamp lies within the time interval provided as second parameter. The property provided as first parameter is the one used to evaluate the condition. This property needs to be used for a member of the input containers for the member object to be considered in the evaluation and included in the result."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 3 ;
  fun:argumentTypes ( rdf:Property t:Interval rdfs:Container )
.

set:newestMember
  rdfs:label "Newest Member Function"@en ;
  rdfs:comment "The function set:newestMember selects the newest member of the container according to a time-stamp property of the member object. The first parameter refers to the property of a member that assigns a time-stamp. This is the time-stamp to be used in the evaluation of this function. The third and all remaining parameters are containers. The function provides the resource as result that is the newest member object within the union of all containers provided as parameters as indicated by the property of the member object that was specified as first function parameter."@en ;
  rdf:type fun:Function ;
  fun:resultType rdf:Resource ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdf:Property rdfs:Container ) 
.

set:oldestMember
  rdfs:label "Oldest Member Function"@en ;
  rdfs:comment "The function set:oldestMember selects the oldest member of the container according to a time-stamp property of the member object. The first parameter refers to the property of a member that assigns a time-stamp. This is the time-stamp to be used in the evaluation of this function. The third and all remaining parameters are containers. The function provides the resource as result that is the oldest member object within the union of all containers provided as parameters as indicated by the property of the member object that was specified as first function parameter."@en ;
  rdf:type fun:Function ;
  fun:resultType rdf:Resource ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdf:Property rdfs:Container )
.

set:resourcesOfType
  rdfs:label "Resources Of Type Function"@en ;
  rdfs:comment "The function set:resourcesOfType represents a container of all resources that are instances of the given classes or its subclasses. Closed world assumption applies. If no argument is given, the resulting container is empty."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Class )
.

set:resourcesWithProperty
  rdfs:label "Resources With Property Function"@en ;
  rdfs:comment "The function set:resourcesWithProperty represents a container of all resource instances that are subject of the properties given as argument. Closed world assumption applies. If no arguments are given, the resulting container is empty."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Property )
.

set:resourcesWithPropertyObject
  rdfs:label "Resources With Property Object Function"@en ;
  rdfs:comment "The function set:resourcesWithPropertyObject represents a container of all resources, to which the property specified in the first argument is used to assign any of the objects of the remaining arguments. Closed world assumption applies."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdfs:Property rdfs:Resource ) 
.

set:typesOfMembers
  rdfs:label "Types Of Members Function"@en ;
  rdfs:comment "The function set:typesOfMembers represents a container of all classes the elements of the containers in the function arguments are instances of. Duplicates are removed from the resulting container and only included once as member. If no arguments are given, the resulting container is empty."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Container ) 
.

set:union
  rdfs:label "Union Function"@en ;
  rdfs:comment "The function set:union represents a container of all resources that are members of the containers specified in the function arguments. If no arguments are given, the resulting container is empty."@en ; 
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:argumentTypes ( rdfs:Container )
.

set:valuesOfObjectProperty
  rdfs:label "Values Of Object Property Function"@en ;
  rdfs:comment "The function set:valuesOfObjectProperty represents a container of all values that are assigned with the property given as first argument to the objects provided by the remaining arguments. If and object has multiple values assigned with this property, or if multiple objects are specified, the result is a superset of all values assigned to provided objects with this property."@en ;
  rdf:type fun:Function ;
  fun:resultType rdfs:Container ;
  fun:arityMin 2 ;
  fun:argumentTypes ( rdf:Property rdfs:Resource )
.

set:Vocabulary
  rdfs:label "Set Operators Vocabulary"@en ;
  rdfs:comment "The object set:Vocabulary is a container of all model elements."@en ;
  rdf:type  rdfs:Container ;
  rdfs:member set:difference ,
              set:elementOf ,
              set:empty ,
              set:forAll ,
              set:includedIn ,
              set:intersection ,
              set:intersectsWith ,
              set:isMember ,
              set:membersAfter ,
              set:membersBefore ,
              set:membersSameTime ,
              set:membersWhile ,
              set:newestMember ,
              set:oldestMember ,
              set:resourcesOfType ,
              set:resourcesWithProperty ,
              set:resourcesWithPropertyObject ,
              set:typesOfMembers ,
              set:union ,
              set:valuesOfObjectProperty
.


# Utility Model v3.6.0

@prefix ut:   <http://tio.models.tmforum.org/tio/v3.6.0/Utility/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix fun:  <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://tio.models.tmforum.org/tio/v3.6.0/Utility/>
  rdf:type imo:IntentExtensionModel ;
  rdfs:label "Utility Model"@en ;
  rdfs:Comment "The utility intent extension model introduces utility information to be added into an intent."@en ;
  dct:title "Utility Model"@en ;
  dct:description "The utility intent extension model introduces utility information to be added into an intent."@en ;
  dct:subject "intent utility"@en ,
              "intent expression"@en ;
  dct:identifier <http://tio.models.tmforum.org/tio/v3.6.0/Utility/> ;
  # dct:isPartOf <http://tio.models.tmforum.org/tio/v3.6.0/TMForumIntentOntology> ;
  dct:replaces <http://tio.models.tmforum.org/tio/v3.5.0/Utility/> ;
  dct:contributor <mailto:joerg.niemoeller@ericsson.com> ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:creator <mailto:joerg.niemoeller@ericsson.com> ;
  dct:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dct:license <https://github.com/tmforum-apis/Intent_Repository> ;
  dct:modified "2024-10-16"^^xsd:date ;
  dct:rights "Copyright © 2024 TM Forum"@en ;
  dct:rightHolder "TM Forum" ;
  dct:publisher "TM Forum" ;
  rdfs:seeAlso <https://www.tmforum.org/resources/how-to-guide/ig1253-intent-in-autonomous-networks-v1-3-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/introductory-guide/tr291i-utility-intent-extension-model-v3-6-0/> ;
  rdfs:seeAlso <https://www.tmforum.org/resources/standard/ig1358-intent-based-operation-user-guide-v1-0-0/> ;
  skos:changeNote "2024-10-16 - initial draft of turtle file"@en 
.

ut:elevatedMaxUtility
  rdfs:label "Elevated Max Utility Property"@en ;
  rdfs:comment "The property ut:elevatedMaxUtility specifies the maximum elevated utility score provided by a utility function. This is the actual maximum utility score used including all implicit prioritization and score elevation."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:range ut:UtilityProfile
.

ut:forMetric
  rdfs:label "For Metric Property"@en ;
  rdfs:comment "The property ut:forMetric maps function arguments to metrics. It contains a list representing a value pair. The first entry in this is the B-node used in the argument list provided by ut:withArguments. The second entry is the metric represented by this B-node. This specifies that values of this metric shall be used as argument of the function. This therefore also specifies for which metrics this utility function is supposed to be used."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ut:UtilityInformation ;
  rdfs:range rdf:List
.

ut:function
  rdfs:label "Function Property"@en ;
  rdfs:comment "The property ut:function assigns a function to utility information. This function shall be used as utility function to calculate a utility score. A function suitable as utility function provides a result with a numeric datatype, such as xsd:decimal or a quantity without unit."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:domain ut:UtilityInformation ;
  rdfs:range fun:Function
.

ut:maxUtility
  rdfs:label "Max Utility Property"@en ;
  rdfs:comment "The property ut:maxUtility is a property of utility profile information. It defines the upper boundary of the value range of utility scores used. In this range ut:maxUtility is interpreted as the maximum business value."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:range ut:UtilityProfile
.

ut:minUtility
  rdfs:label "Min Utility Property"@en ;
  rdfs:comment "The property ut:minUtility is a property of utility profile information. It defines the lower boundary of the value range of utility scores used. In this range ut:minUtility corresponds to the utility score that marks the lowest business value."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:range ut:UtilityProfile
.

ut:utility
  rdfs:label "Utility Property"@en ;
  rdfs:comment "The property ut:utility assigns utility information to an element of an intent."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:range ut:UtilityInformation
.

ut:UtilityInformation
  rdfs:label "Utility Information Class"@en ;
  rdfs:comment "Utility information is expressed by instances of class ut:UtilityInformation."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Information
.

ut:UtilityProfile
  rdfs:label "Utility Profile Class"@en ;
  rdfs:comment "Instances of class ut:UtilityProfile contain information that explains the utility information provided."@en ;
  rdf:type rdfs:Class ;
  rdfs:subClassOf icm:Information
.

ut:utilityProfile
  rdfs:label "Utility Profile Property"@en ;
  rdfs:comment "The property ut:utilityProfile allows assigning utility profiles, for example to intent, other elements within an intent, such as expectations and conditions or utility information objects within an intent. It can also add utility profile information to intent manager capability profiles [TR298] or intent specifications [TR299]."@en ;
  rdf:type rdf:Property ;
  rdfs:subPropertyOf icm:information ;
  rdfs:range ut:UtilityProfile
.

ut:utilityResult
  rdfs:label "Utility Result Property"@en ;
  rdfs:comment "The property ut:utilityResult allows assigning calculated utility scores. It is, for example, used in intent reports to state the utility score associated with a metric observation."@en ;
  rdf:type rdf:Property ;
  rdfs:range ut:UtilityProfile
.

ut:withArgument
  rdfs:label "With Argument Property"@en ;
  rdfs:comment "Utility information specifies the value assigned to an argument for the function using the property ut:withArgument. Its range contains a list with two entries. The first entry is a named argument of the function. The second entry is the value to be used."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ut:UtilityInformation ;
  rdfs:range rdf:List
.

ut:withArguments
  rdfs:label "With Arguments Property"@en ;
  rdfs:comment "Utility information specifies the argument list to be used with the function using the property ut:withArguments. Its range contains a list populated with values and objects that should match the argument specification of the function specified as utility function."@en ;
  rdf:type rdf:Property ;
  rdfs:domain ut:UtilityInformation ;
  rdfs:range rdf:List
.

ut:Vocabulary
  rdfs:label "Utility Vocabulary"@en ;
  rdfs:comment "The object ut:Vocabulary is a container of all model elements."@en ;
  rdf:type rdfs:Container ;
  rdfs:member ut:elevatedMaxUtility ,
              ut:forMetric ,
              ut:function ,
              ut:maxUtility ,
              ut:minUtility ,
              ut:utility ,
              ut:UtilityInformation ,
              ut:UtilityProfile ,
              ut:utilityProfile ,
              ut:utilityResult ,
              ut:withArgument ,
              ut:withArguments
.
