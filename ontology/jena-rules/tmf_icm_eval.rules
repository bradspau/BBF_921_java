# tmf_icm_eval.rules
# IntentCommonModel evaluation rules for Apache Jena GenericRuleReasoner.
# Translated from: ontology/rules/tmf_icm_eval.dlog

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# ── Expectation subclass propagation ─────────────────────────────────────────

[icmDeliveryIsExpectation:
    (?E rdf:type icm:DeliveryExpectation)
    ->
    (?E rdf:type icm:Expectation)
]

[icmPropertyIsExpectation:
    (?E rdf:type icm:PropertyExpectation)
    ->
    (?E rdf:type icm:Expectation)
]

[icmReportingIsExpectation:
    (?E rdf:type icm:ReportingExpectation)
    ->
    (?E rdf:type icm:Expectation)
]

[icmObsReportingIsExpectation:
    (?E rdf:type icm:ObservationReportingExpectation)
    ->
    (?E rdf:type icm:Expectation)
]

# ── IntentElement subclass propagation ───────────────────────────────────────

[icmExpectationIsElement:
    (?E rdf:type icm:Expectation)
    ->
    (?E rdf:type icm:IntentElement)
]

[icmIntentIsElement:
    (?E rdf:type icm:Intent)
    ->
    (?E rdf:type icm:IntentElement)
]

[icmContextIsElement:
    (?E rdf:type icm:Context)
    ->
    (?E rdf:type icm:IntentElement)
]

[icmTargetIsElement:
    (?E rdf:type icm:Target)
    ->
    (?E rdf:type icm:IntentElement)
]

[icmInformationIsElement:
    (?E rdf:type icm:Information)
    ->
    (?E rdf:type icm:IntentElement)
]

# ── Target is also a Container ────────────────────────────────────────────────

[icmTargetIsContainer:
    (?T rdf:type icm:Target)
    ->
    (?T rdf:type rdfs:Container)
]

# ── DeliveryExpectation fulfillment ───────────────────────────────────────────

[icmDeliveryFulfilled:
    (?E rdf:type icm:DeliveryExpectation)
    (?E icm:target ?T)
    (?T rdfs:member ?M)
    (?E icm:deliveryType ?C)
    (?M rdf:type ?C)
    ->
    (?E icm:result "true"^^xsd:boolean)
]

# ── PropertyExpectation result ────────────────────────────────────────────────

[icmPropertyResult:
    (?E rdf:type icm:PropertyExpectation)
    (?E rdf:value "true"^^xsd:boolean)
    ->
    (?E icm:result "true"^^xsd:boolean)
]

# ── Target type assertion from icm:target property ────────────────────────────

[icmTargetType:
    (?E icm:target ?T)
    ->
    (?T rdf:type icm:Target)
]

# ── ContextReport and TargetReport type propagation ──────────────────────────

[icmContextReport:
    (?X icm:contextReport ?R)
    ->
    (?R rdf:type icm:ContextReport)
]

[icmTargetReport:
    (?X icm:targetReport ?R)
    ->
    (?R rdf:type icm:TargetReport)
]

# ── IntentReport type assertion ───────────────────────────────────────────────

[icmIntentReportFromGenerated:
    (?R icm:reportGenerated ?T)
    ->
    (?R rdf:type icm:IntentReport)
]

[icmIntentReportFromNumber:
    (?R icm:reportNumber ?N)
    ->
    (?R rdf:type icm:IntentReport)
]
