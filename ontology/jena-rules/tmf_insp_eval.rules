# tmf_insp_eval.rules
# IntentSpecification evaluation rules for Apache Jena GenericRuleReasoner.
# Translated from: ontology/rules/tmf_insp_eval.dlog
#
# Corrections applied:
#   Line 210 of source had bare `inspalternative` (missing prefix).
#   Corrected to `insp:inspalternative` here.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix met:  <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# ── Template type hierarchy ───────────────────────────────────────────────────

[inspContentIsTemplate:
    (?T rdf:type insp:inspContentTemplate)
    ->
    (?T rdf:type insp:inspTemplate)
]

[inspObjectIsTemplate:
    (?T rdf:type insp:inspObjectTemplate)
    ->
    (?T rdf:type insp:inspTemplate)
]

[inspVocabularyIsTemplate:
    (?T rdf:type insp:inspVocabularyTemplate)
    ->
    (?T rdf:type insp:inspTemplate)
]

[inspVocabularyIsContainer:
    (?T rdf:type insp:inspVocabularyTemplate)
    ->
    (?T rdf:type rdfs:Container)
]

# ── Mandatory / alternative / optional content materialised ───────────────────

[inspMandatoryContent:
    (?S insp:inspmandatory ?C)
    ->
    (?C rdf:type insp:inspContentTemplate)
]

[inspAlternativeContent:
    (?S insp:inspalternative ?C)
    ->
    (?C rdf:type insp:inspContentTemplate)
]

[inspOptionContent:
    (?S insp:inspoption ?C)
    ->
    (?C rdf:type insp:inspContentTemplate)
]

# ── Object template allowed values container ──────────────────────────────────

[inspAllowedValuesContainer:
    (?OT insp:inspallowedValues ?V)
    ->
    (?V rdf:type rdfs:Container)
]

# ── inspvalueSelected: true if chosen object is in allowed container ──────────

[inspValueSelected:
    (?F rdf:type insp:inspvalueSelected)
    (?F rdf:first ?OT)
    (?F rdf:rest ?Rest)
    (?Rest rdfs:member ?AllowedContainer)
    (?OT insp:inspallowedValues ?Vals)
    (?Vals rdfs:member ?Chosen)
    (?AllowedContainer rdfs:member ?Chosen)
    ->
    (?F rdf:value "true"^^xsd:boolean)
]

# ── inspchosenAny: true if any chosen content template has content ─────────────

[inspChosenAny:
    (?F rdf:type insp:inspchosenAny)
    (?F rdfs:member ?CT)
    (?CT rdf:type insp:inspContentTemplate)
    (?CT insp:inspcontent ?Any)
    ->
    (?F rdf:value "true"^^xsd:boolean)
]

# ── inspusedVocabularyFor: true if intent element uses a vocabulary term ───────

[inspUsedVocabularyFor:
    (?F rdf:type insp:inspusedVocabularyFor)
    (?F rdf:first ?IntentElem)
    (?F rdf:rest ?VocabList)
    (?VocabList rdfs:member ?VocabContainer)
    (?VocabContainer rdfs:member ?Term)
    (?IntentElem ?Term ?Any)
    ->
    (?F rdf:value "true"^^xsd:boolean)
]

# ── inspselectValues: ground selection container with compliant values ─────────

[inspSelectValues:
    (?F rdf:type insp:inspselectValues)
    (?F rdf:first ?Var)
    (?F rdf:rest ?CondList)
    (?CondList rdfs:member ?Cond)
    (?Cond rdf:value "true"^^xsd:boolean)
    (?Var rdf:value ?V)
    (?R insp:inspselectValues ?F)
    ->
    (?R rdfs:member ?V)
]

# ── Property type assertions for handler domain / intent handler ───────────────

[inspChosenHandlingDomainIsProperty:
    (?P rdf:type insp:inspchosenHandlingDomain)
    ->
    (?P rdf:type rdf:Property)
]

[inspChosenIntentHandlerIsProperty:
    (?P rdf:type insp:inspchosenIntentHandler)
    ->
    (?P rdf:type rdf:Property)
]
